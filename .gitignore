# private runtime data — never committed
logs/
state/

# TUI screenshot artifacts (save_screenshot writes SVG into cwd)
victus-suite_*.svg

# vertil lab: build artifacts + runtime (only sources are committed)
vertil/tools/lab/cpuburn
vertil/tools/lab/gpuload
vertil/tools/lab/*.log
vertil/tools/lab/*.state

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# local-only user config
config/*.local
config/local/
