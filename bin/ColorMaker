#!/usr/bin/env python3
"""ColorMaker — create/list/remove named keyboard colors (English names only).

Storage: ~/.config/victus-kbd/colors.conf   (name = r,g,b)
Backend: ~/.local/bin/victus-kbd            (writes EC, needs root)

Usage:
  ColorMaker list
  ColorMaker show <name>
  ColorMaker add <name> <r> <g> <b>
  ColorMaker add <name> "#RRGGBB"
  ColorMaker rm <name>
  ColorMaker palette            # print built-in palette (English names)
"""

import os
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, _HERE)
import victus_log as vlog  # noqa: E402
import victus_palette as pal  # noqa: E402
from i18n import t  # noqa: E402

TOOL = "ColorMaker"

CONF_DIR = vlog.config_dir()
CONF = os.path.join(CONF_DIR, "colors.conf")

BUILTIN = pal.BUILTIN
NAME_RE = pal.NAME_RE


def die(msg):
    vlog.log_error(TOOL, msg, exc=False)
    print(f"ColorMaker: {msg}", file=sys.stderr)
    sys.exit(1)


def load():
    return pal.all_colors(CONF)


def save(colors):
    try:
        os.makedirs(CONF_DIR, exist_ok=True)
        custom = {k: v for k, v in colors.items() if k not in BUILTIN}
        with open(CONF, "w") as f:
            f.write("# user colors (English names only): name = r,g,b\n")
            for name in sorted(custom):
                f.write(f"{name} = {','.join(str(v) for v in custom[name])}\n")
    except OSError as e:
        die(t("cm.write_failed", path=CONF, err=e))


def parse_rgb(args):
    if len(args) == 1:
        rgb = pal.parse(args[0])
        if rgb is not None:
            return rgb
    if len(args) == 3:
        vals = [int(a) for a in args]
        if all(0 <= v <= 255 for v in vals):
            return tuple(vals)
    die(t("cm.bad_rgb"))



def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "list"
    colors = load()

    if cmd == "list":
        for name in sorted(colors):
            r, g, b = colors[name]
            print(f"{name:<14} rgb({r:>3},{g:>3},{b:>3})  #{r:02x}{g:02x}{b:02x}")
        return

    if cmd == "palette":
        for name in sorted(BUILTIN):
            r, g, b = BUILTIN[name]
            print(f"{name:<14} #{r:02x}{g:02x}{b:02x}")
        return

    if cmd == "show":
        if len(args) != 2:
            die(t("cm.usage_show"))
        name = args[1].lower()
        if name not in colors:
            die(t("cm.unknown_color", name=name))
        r, g, b = colors[name]
        print(f"{name} = {r},{g},{b}  #{r:02x}{g:02x}{b:02x}")
        return

    if cmd == "add":
        if len(args) < 3:
            die(t("cm.usage_add"))
        name = args[1].lower()
        if not NAME_RE.match(name):
            die(t("cm.name_rule"))
        rgb = parse_rgb(args[2:])
        colors[name] = rgb
        save(colors)
        vlog.log_info(TOOL, f"add {name}={rgb} -> {CONF}")
        print(t("cm.saved", name=name, rgb=f"{rgb[0]},{rgb[1]},{rgb[2]}", path=CONF))
        return

    if cmd == "rm":
        if len(args) != 2:
            die(t("cm.usage_rm"))
        name = args[1].lower()
        if name in BUILTIN:
            die(t("cm.builtin_locked", name=name))
        if name not in colors:
            die(t("cm.unknown_color", name=name))
        del colors[name]
        save(colors)
        vlog.log_info(TOOL, f"rm {name}")
        print(t("cm.removed", name=name))
        return

    die(t("common.unknown_command", cmd=cmd, allowed="list|palette|show|add|rm"))


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except BrokenPipeError:
        try:
            sys.stdout.close()
        finally:
            os._exit(0)
    except Exception as e:
        vlog.log_exception(TOOL, f"unhandled {type(e).__name__}: {e}")
        print(t("common.unhandled", tool=TOOL, type=type(e).__name__, msg=e), file=sys.stderr)
        print(t("common.see_log", path=vlog.log_path()), file=sys.stderr)
        sys.exit(1)
