#!/usr/bin/env python3
"""ColorMaker — create/list/remove named keyboard colors (English names only).

Storage: ~/.config/victus-kbd/colors.conf   (name = r,g,b)
Backend: ~/.local/bin/victus-kbd            (writes EC, needs root)

Usage:
  ColorMaker list
  ColorMaker show <name>
  ColorMaker add <name> <r> <g> <b>
  ColorMaker add <name> "#RRGGBB"
  ColorMaker rm <name>
  ColorMaker palette            # print built-in palette (English names)
"""

import os
import re
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, _HERE)
import victus_log as vlog  # noqa: E402

TOOL = "ColorMaker"

CONF_DIR = vlog.config_dir()
CONF = os.path.join(CONF_DIR, "colors.conf")

BUILTIN = {
    "red": (255, 0, 0),
    "fire": (255, 50, 0),
    "scarlet": (255, 20, 20),
    "darkred": (139, 0, 0),
    "green": (0, 255, 0),
    "blue": (0, 0, 255),
    "white": (255, 255, 255),
    "black": (0, 0, 0),
    "off": (0, 0, 0),
    "yellow": (255, 255, 0),
    "cyan": (0, 255, 255),
    "magenta": (255, 0, 255),
    "pink": (255, 105, 180),
    "hotpink": (255, 20, 147),
    "lightpink": (255, 192, 203),
    "rose": (255, 0, 127),
    "purple": (128, 0, 128),
    "violet": (143, 0, 255),
    "indigo": (75, 0, 130),
    "orange": (255, 165, 0),
    "coral": (255, 127, 80),
    "salmon": (250, 128, 114),
    "crimson": (220, 20, 60),
    "maroon": (128, 0, 0),
    "gold": (255, 215, 0),
    "lime": (0, 255, 0),
    "teal": (0, 128, 128),
    "skyblue": (135, 206, 235),
    "turquoise": (64, 224, 208),
    "navy": (0, 0, 128),
    "olive": (128, 128, 0),
    "gray": (128, 128, 128),
    "silver": (192, 192, 192),
    "brown": (165, 42, 42),
    "tan": (210, 180, 140),
    "beige": (245, 245, 220),
    "ivory": (255, 255, 240),
    "lavender": (230, 230, 250),
    "plum": (221, 160, 221),
    "orchid": (218, 112, 214),
    "chocolate": (210, 105, 30),
    "wine": (114, 47, 55),
    "neonpurple": (191, 64, 255),
    "neonpink": (255, 24, 160),
    "neongreen": (57, 255, 20),
    "iceblue": (99, 203, 255),
    "warmwhite": (255, 244, 229),
    "coolwhite": (220, 240, 255),
}

NAME_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")


def die(msg):
    vlog.log_error(TOOL, msg, exc=False)
    print(f"ColorMaker: {msg}", file=sys.stderr)
    sys.exit(1)


def load():
    colors = dict(BUILTIN)
    if os.path.exists(CONF):
        with open(CONF) as f:
            for lineno, line in enumerate(f, 1):
                raw = line.rstrip("\n")
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" not in line:
                    vlog.log("warn", TOOL, f"{CONF}:{lineno}: no '=' in {raw!r}")
                    continue
                name, val = line.split("=", 1)
                try:
                    rgb = tuple(int(x) for x in val.split(","))
                except ValueError:
                    vlog.log("warn", TOOL, f"{CONF}:{lineno}: bad rgb {val!r}")
                    continue
                if len(rgb) == 3 and all(0 <= v <= 255 for v in rgb):
                    colors[name.strip()] = rgb
                else:
                    vlog.log(
                        "warn",
                        TOOL,
                        f"{CONF}:{lineno}: out of range rgb {rgb} (line {raw!r})",
                    )
    return colors


def save(colors):
    try:
        os.makedirs(CONF_DIR, exist_ok=True)
        custom = {k: v for k, v in colors.items() if k not in BUILTIN}
        with open(CONF, "w") as f:
            f.write("# user colors (English names only): name = r,g,b\n")
            for name in sorted(custom):
                f.write(f"{name} = {','.join(str(v) for v in custom[name])}\n")
    except OSError as e:
        die(f"cannot write {CONF}: {e}")


def parse_rgb(args):
    if len(args) == 1 and args[0].startswith("#") and len(args[0]) == 7:
        h = args[0][1:]
        return (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))
    if len(args) == 3:
        vals = [int(a) for a in args]
        if all(0 <= v <= 255 for v in vals):
            return tuple(vals)
    die("expected: <r> <g> <b> (0-255) or #RRGGBB")


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "list"
    colors = load()

    if cmd == "list":
        for name in sorted(colors):
            r, g, b = colors[name]
            print(f"{name:<14} rgb({r:>3},{g:>3},{b:>3})  #{r:02x}{g:02x}{b:02x}")
        return

    if cmd == "palette":
        for name in sorted(BUILTIN):
            r, g, b = BUILTIN[name]
            print(f"{name:<14} #{r:02x}{g:02x}{b:02x}")
        return

    if cmd == "show":
        if len(args) != 2:
            die("usage: ColorMaker show <name>")
        name = args[1].lower()
        if name not in colors:
            die(f"unknown color '{name}'")
        r, g, b = colors[name]
        print(f"{name} = {r},{g},{b}  #{r:02x}{g:02x}{b:02x}")
        return

    if cmd == "add":
        if len(args) < 3:
            die("usage: ColorMaker add <name> <r> <g> <b> | <name> #RRGGBB")
        name = args[1].lower()
        if not NAME_RE.match(name):
            die("name must be lowercase english: a-z, 0-9, '-', '_'")
        rgb = parse_rgb(args[2:])
        colors[name] = rgb
        save(colors)
        vlog.log_info(TOOL, f"add {name}={rgb} -> {CONF}")
        print(f"saved {name} = {rgb[0]},{rgb[1]},{rgb[2]} -> {CONF}")
        return

    if cmd == "rm":
        if len(args) != 2:
            die("usage: ColorMaker rm <name>")
        name = args[1].lower()
        if name in BUILTIN:
            die(f"'{name}' is built-in, cannot remove")
        if name not in colors:
            die(f"unknown color '{name}'")
        del colors[name]
        save(colors)
        vlog.log_info(TOOL, f"rm {name}")
        print(f"removed {name}")
        return

    die(f"unknown command '{cmd}' (list|palette|show|add|rm)")


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except Exception as e:
        vlog.log_exception(TOOL, f"unhandled {type(e).__name__}: {e}")
        print(f"ColorMaker: {type(e).__name__}: {e}", file=sys.stderr)
        print(f"ColorMaker: see log {vlog.log_path()}", file=sys.stderr)
        sys.exit(1)
