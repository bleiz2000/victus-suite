#!/usr/bin/env python3
"""victus_tui — интерфейс victus-suite (подсветка клавиатуры).

Запуск:
  victus_tui               фоновый демон + TUI в текущем терминале
  victus_tui --window      отдельное окно foot 960×540 (≈1/4 экрана 1080p)
  victus_tui --tray        только демон + иконка в трее (окно не нужно)
  victus_tui --stop        остановить фоновый демон
  VICTUS_DRY_RUN=1 ...     без записи в EC

Фоновый режим: пока живёт bin/victusd, эффект крутится и без открытого TUI —
интерфейс можно закрывать, состояние он подхватит заново.
"""

import os
import shutil
import subprocess
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, _HERE)

import victus_log as vlog  # noqa: E402
from i18n import t  # noqa: E402

TOOL = "victus_tui"
TRAY = os.path.join(_HERE, "victus-tray")
WIN_W, WIN_H = 960, 540


def spawn_window() -> bool:
    """Окно foot 960×540 (kitty — запасной вариант)."""
    from tui import core  # noqa: F401  (i18n/логи уже на месте)

    title = t("tui.app_title")
    exe = os.path.realpath(__file__)
    env = os.environ.copy()
    env.setdefault("VICTUS_LANG", "")
    candidates = [
        ("foot", ["foot", "-a", "victus-suite", "-T", title, "-w", f"{WIN_W}x{WIN_H}"]),
        (
            "kitty",
            [
                "kitty",
                "-T", title,
                "--class", "victus-suite",
                "-o", f"initial_window_width={WIN_W}",
                "-o", f"initial_window_height={WIN_H}",
            ],
        ),
    ]
    for name, argv in candidates:
        if not shutil.which(name):
            continue
        try:
            subprocess.Popen(
                argv + [exe],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL,
                start_new_session=True,
                env=env,
            )
        except OSError as e:
            vlog.log_error(TOOL, f"{name} spawn failed: {e}", exc=False)
            continue
        vlog.log_info(TOOL, f"window via {name} {WIN_W}x{WIN_H}")
        _hint_float_rule()
        return True
    return False


def _hint_float_rule():
    """Hyprland — окно и так всплывает; просто фиксируем факт в логе."""
    hypr = shutil.which("hyprctl")
    if not hypr:
        return
    try:
        out = subprocess.run(
            [hypr, "activewindow", "-j"],
            capture_output=True, text=True, timeout=2.0,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return
    if "victus-suite" in out:
        vlog.log_info(TOOL, "hyprland: окно victus-suite активно")


def stop_daemon() -> int:
    from tui import core

    reply = core.request_sync("quit")
    print(reply if reply else {"ok": False, "msg": "демон не запущен"})
    return 0 if reply and reply.get("ok") else 1


def run_tray() -> int:
    if not os.access(TRAY, os.X_OK):
        print("нет " + TRAY, file=sys.stderr)
        return 1
    os.execv(TRAY, [TRAY])
    return 1


def main():
    args = sys.argv[1:]
    if "--help" in args or "-h" in args:
        print(__doc__)
        return 0
    if "--stop" in args:
        return stop_daemon()
    if "--tray" in args:
        return run_tray()
    if "--window" in args:
        if spawn_window():
            return 0
        # ни foot, ни kitty — при запуске из меню stderr никто не видит,
        # поэтому докрикиваемся уведомлением
        msg = t("tui.no_terminal")
        print(msg, file=sys.stderr)
        try:
            if shutil.which("notify-send"):
                subprocess.run(
                    ["notify-send", "-u", "critical", "-a", "Victus Suite",
                     t("tui.app_title"), msg],
                    timeout=5, check=False,
                )
        except (OSError, subprocess.SubprocessError):
            pass
        return 1

    vlog.log_info(TOOL, f"start euid={os.geteuid()} (static, no autostart)")
    try:
        from tui.screens import VictusApp
    except ModuleNotFoundError as e:
        vlog.log_error(TOOL, f"missing dependency: {e}", exc=False)
        print(t("tui.need_textual", err=e), file=sys.stderr)
        return 1
    VictusApp().run()
    vlog.log_info(TOOL, "exit")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
