#!/usr/bin/env python3
"""Changer — apply a color to the HP Victus keyboard backlight.

Usage:
  Changer <name>              # e.g. Changer pink
  Changer <r> <g> <b>         # e.g. Changer 255 105 180
  Changer "#RRGGBB"
  Changer list                # show available color names
  Changer random              # random from palette
  Changer off                 # switch backlight color off

Backend: sudo victus-kbd  (writes EC registers)
Extras:  Changer cycle-red   bright red cycle
         Changer cycle red fire --delay 1
         Changer stop
"""

import os
import random
import subprocess
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, _HERE)
import victus_log as vlog  # noqa: E402
import victus_palette as pal  # noqa: E402
from i18n import t  # noqa: E402

TOOL = "Changer"

BACKEND = os.path.join(_HERE, "victus-kbd")
CONF = os.path.join(vlog.config_dir(), "colors.conf")
NAME_RE = pal.NAME_RE


def die(msg):
    vlog.log_error(TOOL, msg, exc=False)
    print(f"Changer: {msg}", file=sys.stderr)
    sys.exit(1)


def load_colors():
    colors = pal.all_colors(CONF)
    if not colors:
        vlog.log("warn", TOOL, "palette is empty")
    return colors


def run_backend(argv):
    if not os.path.exists(BACKEND):
        die(t("changer.backend_missing", path=BACKEND))
    dry = os.environ.get("VICTUS_DRY_RUN") == "1"
    prefix = [] if (dry or os.geteuid() == 0) else ["sudo"]
    cmd = prefix + [BACKEND] + [str(a) for a in argv]
    vlog.log_info(TOOL, f"run {' '.join(cmd)}")
    result = subprocess.run(cmd)
    if result.returncode != 0:
        vlog.log_error(
            TOOL, f"backend failed rc={result.returncode} argv={argv!r}", exc=False
        )
    else:
        vlog.log_info(TOOL, f"backend ok argv={argv!r}")
    sys.exit(result.returncode)


def apply(rgb):
    run_backend([str(rgb[0]), str(rgb[1]), str(rgb[2])])


def resolve_token(tok, colors):
    """Turn a user color token into a backend token (name -> R,G,B)."""
    if tok.startswith("--") or "," in tok or tok.startswith("#"):
        return tok
    if tok in colors:
        r, g, b = colors[tok]
        return f"{r},{g},{b}"
    return tok


def main():
    args = sys.argv[1:]
    vlog.log_info(TOOL, f"invoke argv={args!r}")
    if not args:
        die(t("changer.usage"))

    cmd = args[0].lower()

    if cmd == "list":
        subprocess.run(["ColorMaker", "list"])
        return

    if cmd == "stop":
        run_backend(["stop"])

    if cmd in ("cycle", "cycle-red"):
        rest = list(args[1:])
        if cmd == "cycle-red":
            rest = ["red", "fire", "darkred", "--delay", "1", "--bg"] + rest
        colors = load_colors()
        resolved = []
        i = 0
        while i < len(rest):
            tok = rest[i]
            if tok == "--delay" and i + 1 < len(rest):
                resolved.append(tok)
                resolved.append(rest[i + 1])
                i += 2
                continue
            resolved.append(resolve_token(tok, colors))
            i += 1
        run_backend(["cycle"] + resolved)

    if cmd == "off":
        apply((0, 0, 0))
        return

    if cmd == "random":
        colors = load_colors()
        palette = [v for k, v in colors.items() if k != "off"]
        if not palette:
            die(t("changer.no_colors"))
        apply(random.choice(palette))
        return

    if len(args) == 1:
        token = args[0]
        colors = load_colors()
        rgb = pal.parse(token, colors)
        if rgb is not None:
            apply(rgb)
            return
        if NAME_RE.match(token):
            die(t("changer.unknown_color", name=token))

    if len(args) == 3:
        try:
            rgb = tuple(int(a) for a in args)
        except ValueError:
            die(t("changer.rgb_int"))
        if not all(0 <= v <= 255 for v in rgb):
            die(t("changer.rgb_range"))
        apply(rgb)
        return

    die(t("changer.unknown_args", args=" ".join(args)))


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except BrokenPipeError:
        try:
            sys.stdout.close()
        finally:
            os._exit(0)
    except Exception as e:
        vlog.log_exception(TOOL, f"unhandled {type(e).__name__}: {e}")
        print(t("common.unhandled", tool=TOOL, type=type(e).__name__, msg=e), file=sys.stderr)
        print(t("common.see_log", path=vlog.log_path()), file=sys.stderr)
        sys.exit(1)
