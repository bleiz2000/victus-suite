#!/usr/bin/env python3
"""HP Victus keyboard RGB via ACPI EC (/sys/kernel/debug/ec/ec0/io)."""

import json
import os
import subprocess
import sys
import time

_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, _HERE)
import victus_log as vlog  # noqa: E402
import victus_palette as pal  # noqa: E402
from i18n import t  # noqa: E402

TOOL = "victus-kbd"

# Состояние TUI (rgb/power/effect): его же читает вкладка «Клавиатура».
# Клавиша на корпусе меняет EC и ЭТОТ файл, иначе приложение показало бы
# своё старое значение до следующего перезапуска.
STATE_FILE = os.path.join(vlog.state_dir(), "last_state.json")

EC_PATH = "/sys/kernel/debug/ec/ec0/io"
OFFSETS = (8, 9, 10)


def die(msg):
    vlog.log_error(TOOL, msg, exc=False)
    print(f"victus-kbd: {msg}", file=sys.stderr)
    sys.exit(1)


DRY = os.environ.get("VICTUS_DRY_RUN") == "1"
_dry_state = [255, 255, 255]


def ec_ready():
    """EC-узел существует и в него можно писать текущим юзером."""
    return os.path.exists(EC_PATH) and os.access(EC_PATH, os.W_OK)


def ensure_ec():
    if DRY:
        return
    if ec_ready():
        return
    if os.geteuid() != 0:
        # не root и EC не доступен — дальше всё равно упадёт, скажем сразу
        if not os.path.exists(EC_PATH):
            die(t("kbd.ec_unavailable"))
        die(t("kbd.ec_not_writable", path=EC_PATH))
    if not os.path.exists("/sys/kernel/debug"):
        vlog.log_info(TOOL, "mounting debugfs")
        subprocess.run(
            ["mount", "-t", "debugfs", "none", "/sys/kernel/debug"], check=True
        )
    if not os.path.exists(EC_PATH):
        vlog.log_info(TOOL, "loading ec_sys write_support=1")
        subprocess.run(["modprobe", "ec_sys", "write_support=1"], check=True)
    if not os.path.exists(EC_PATH):
        die(t("kbd.ec_unavailable"))
    if not os.access(EC_PATH, os.W_OK):
        die(t("kbd.ec_not_writable", path=EC_PATH))


def read_rgb():
    if DRY:
        return tuple(_dry_state)
    with open(EC_PATH, "rb") as f:
        f.seek(OFFSETS[0])
        return tuple(f.read(3))


def write_rgb(r, g, b):
    if DRY:
        _dry_state[:] = [r, g, b]
        print(f"[dry-run] rgb -> {r},{g},{b}", flush=True)
        return
    with open(EC_PATH, "r+b", buffering=0) as f:
        f.seek(OFFSETS[0])
        f.write(bytes((r, g, b)))


def dump(start, length):
    with open(EC_PATH, "rb") as f:
        f.seek(start)
        data = f.read(length)
    for i in range(0, len(data), 16):
        chunk = data[i : i + 16]
        hexpart = " ".join(f"{b:02x}" for b in chunk)
        asc = "".join(chr(b) if 32 <= b < 127 else "." for b in chunk)
        print(f"{start + i:04x}: {hexpart:<47} {asc}")


def parse_color(tok):
    rgb_val = pal.parse(tok)
    if rgb_val is None:
        die(t("kbd.bad_color", tok=tok))
    return rgb_val


def pidfile():
    return os.path.join(vlog.state_dir(), "cycle.pid")


def read_pid():
    try:
        with open(pidfile()) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False


def cmd_stop():
    pid = read_pid()
    if pid is None or not alive(pid):
        if os.path.exists(pidfile()):
            os.remove(pidfile())
        print(t("kbd.cycle_not_running"))
        vlog.log_info(TOOL, "stop: no cycle running")
        return
    os.kill(pid, 15)
    for _ in range(20):
        if not alive(pid):
            break
        time.sleep(0.1)
    if os.path.exists(pidfile()):
        os.remove(pidfile())
    print(t("kbd.cycle_stopped", pid=pid))
    vlog.log_info(TOOL, f"stop: killed pid {pid}")


def _load_state() -> dict:
    try:
        with open(STATE_FILE, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        data = {}
    return data if isinstance(data, dict) else {}


def _save_state(data: dict) -> None:
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        with open(STATE_FILE, "w", encoding="utf-8") as fh:
            json.dump(data, fh, ensure_ascii=False, indent=2)
            fh.write("\n")
    except OSError as exc:
        vlog.log_warn(TOOL, f"state save failed: {exc}")


def cmd_power(args: list) -> None:
    """Подсветка клавиатуры: on | off | toggle.

    Живёт и в EC, и в last_state.json — это и есть синхронизация с TUI:
    горячая клавиша гасит свет, вкладка «Клавиатура» на следующем тике
    видит power=false и сама перетягивает тумблер.
    """
    action = (args[0].lower() if args else "toggle")
    if action not in ("on", "off", "toggle"):
        die(t("kbd.usage"))
    st = _load_state()
    lit = any(read_rgb())
    if action == "toggle":
        action = "off" if lit else "on"
    if action == "off":
        cmd_stop()                      # петля иначе перерисует чёрное обратно
        write_rgb(0, 0, 0)
        st["power"] = False
        st["running"] = False
    else:
        rgb = st.get("rgb") or [255, 255, 255]
        try:
            r, g, b = int(rgb[0]), int(rgb[1]), int(rgb[2])
        except (TypeError, ValueError, IndexError):
            r, g, b = 255, 255, 255
        write_rgb(r, g, b)
        st["power"] = True
    _save_state(st)
    print("power=%s rgb=%s" % (
        "on" if st.get("power") else "off", ",".join(map(str, read_rgb()))))
    vlog.log_info(TOOL, f"power {action} -> {st.get('power')}")


def cmd_cycle(args):
    delay = 1.0
    bg = False
    is_child = False
    colors = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--bg":
            bg = True
        elif a == "--is-child":
            is_child = True
        elif a == "--delay":
            i += 1
            if i >= len(args):
                die(t("kbd.cycle_delay_value"))
            delay = float(args[i])
        elif a.startswith("--delay="):
            delay = float(a.split("=", 1)[1])
        else:
            colors.append(a)
        i += 1

    if not colors:
        die(t("kbd.cycle_need_color"))
    if delay < 0.05:
        die(t("kbd.cycle_delay_min"))
    rgb_list = [parse_color(c) for c in colors]

    existing = read_pid()
    if existing is not None and alive(existing) and existing != os.getpid():
        if not is_child:
            die(t("kbd.cycle_running", pid=existing))

    if bg:
        os.makedirs(vlog.state_dir(), exist_ok=True)
        cmd = [sys.executable, os.path.realpath(__file__), "cycle"]
        cmd += colors + ["--delay", str(delay), "--is-child"]
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        with open(pidfile(), "w") as f:
            f.write(str(proc.pid))
        print(t("kbd.cycle_started", pid=proc.pid, colors=rgb_list, delay=delay))
        vlog.log_info(TOOL, f"cycle start pid={proc.pid} colors={rgb_list} delay={delay}")
        return

    os.makedirs(vlog.state_dir(), exist_ok=True)
    with open(pidfile(), "w") as f:
        f.write(str(os.getpid()))
    vlog.log_info(TOOL, f"cycle loop pid={os.getpid()} colors={rgb_list} delay={delay}")
    print(t("kbd.cycle_loop", colors=rgb_list, delay=delay), flush=True)
    # шаг = запись (замер: ≈3-4 мс); чтение-проверка стоит ~90 мс и почти
    # вдвое замедляла бы петлю — ради debug-строки оставляем её только при
    # VICTUS_LOG=debug (см. vlog.debug_enabled)
    with_read = vlog.debug_enabled()
    try:
        while True:
            for rgb in rgb_list:
                write_rgb(*rgb)
                if with_read:
                    got = read_rgb()
                    vlog.log_debug(TOOL, f"cycle -> {got}")
                time.sleep(delay)
    except KeyboardInterrupt:
        vlog.log_info(TOOL, "cycle interrupted by user")
    finally:
        if read_pid() == os.getpid() and os.path.exists(pidfile()):
            os.remove(pidfile())


def cmd_fans(argv: list) -> int:
    """Подкоманда vertil — запись вентиляторов (fanctl).

    Живёт здесь, чтобы пользоваться уже выданным NOPASSWD-правилом на этот
    бинарник (README): TUI зовёт `sudo -n victus-kbd fans <cmd>` и не спрашивает
    пароль. Ни EC, ни root-проверка тут не участвуют — права решает fanctl.
    """
    tools = os.path.join(os.path.dirname(_HERE), "vertil", "tools")
    if not os.path.isdir(tools):
        print(t("kbd.fans_missing", path=tools), file=sys.stderr)
        return 2
    if tools not in sys.path:
        sys.path.insert(0, tools)
    import fanctl  # noqa: PLC0415 — только для этой подкоманды
    return int(fanctl.main(argv))


def main():
    args = sys.argv[1:]
    vlog.log_info(TOOL, f"invoke euid={os.geteuid()} argv={args!r}")

    cmd = args[0].lower() if args else ""

    # vertil: раньше проверки EC — тут не нужен ни EC, ни root
    if cmd == "fans":
        sys.exit(cmd_fans(args[1:]))

    # stop не трогает EC (только pid-файл) — работает и без root
    if os.geteuid() != 0 and not DRY and not ec_ready() and cmd != "stop":
        die(t("common.run_with_sudo", tool=TOOL))

    if not args:
        ensure_ec()
        print(t("kbd.current", rgb=read_rgb()))
        print(t("kbd.usage"))
        return

    cmd = args[0].lower()

    if cmd == "cycle":
        ensure_ec()
        cmd_cycle(args[1:])
        return

    if cmd == "stop":
        cmd_stop()
        return

    if cmd == "power":
        ensure_ec()
        cmd_power(args[1:])
        return

    if cmd == "dump":
        ensure_ec()
        start = int(args[1], 0) if len(args) > 1 else 0
        length = int(args[2], 0) if len(args) > 2 else 64
        dump(start, length)
        vlog.log_debug(TOOL, f"dump start={start} len={length} ok")
        return

    ensure_ec()

    if cmd == "get":
        print(*read_rgb())
        return

    palette = pal.all_colors()

    if cmd in palette:
        rgb = palette[cmd]
    elif len(args) == 3:
        rgb = tuple(int(a) for a in args)
    elif len(args) == 1:
        rgb = parse_color(args[0])
    else:
        die(t("kbd.unknown_args", args=" ".join(args)))

    if len(rgb) != 3 or any(v < 0 or v > 255 for v in rgb):
        die(t("kbd.bad_rgb", rgb=rgb))

    before = read_rgb()
    write_rgb(*rgb)
    after = read_rgb()
    if after != tuple(rgb):
        if after == (0, 0, 0) and tuple(rgb) != (0, 0, 0):
            die(t("kbd.write_failed", wrote=rgb, got=after))
        vlog.log("warn", TOOL, f"readback {after} != written {rgb} (EC clamps)")
    vlog.log_info(TOOL, f"rgb {before} -> {after}")
    print(t("kbd.rgb_changed", before=before, after=after))


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except BrokenPipeError:
        try:
            sys.stdout.close()
        finally:
            os._exit(0)
    except Exception as e:
        vlog.log_exception(TOOL, f"unhandled {type(e).__name__}: {e}")
        print(t("common.unhandled", tool=TOOL, type=type(e).__name__, msg=e), file=sys.stderr)
        print(t("common.see_log", path=vlog.log_path()), file=sys.stderr)
        sys.exit(1)
