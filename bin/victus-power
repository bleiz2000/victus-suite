#!/usr/bin/env python3
"""victus-power — root-хелпер режимов питания victus-suite.

Один узкий вход в права: sudoers даёт NOPASSWD только на этот файл, поэтому
команды жёстко белый-листятся (никакого shell, никаких произвольных путей).

Команды:
    victus-power status [--json]     прочитать все ручки (read-only)
    victus-power apply typewriter    режим «Печатная машинка» (сохраняя прошлое)
    victus-power restore             вернуть снимок, сделанный перед apply
    victus-power mux <hybrid|discrete>  явное переключение MUX (нужен reboot)
    victus-power watts <5..25>          потолок мощности CPU (режим включён)
    victus-power draw [--dur S]         живая мощность пакета CPU из RAPL
    victus-power cascade <5..25> [--cpu N] [--no-stabilize]
                                        каскад на цель по ВСЕМУ ноутбуку:
                                        один ползунок = потолок всей системы,
                                        замер факта и подтяжка плана к цели
    victus-power cascade-off            снять каскад (яркость/BT/USB/фон)
    victus-power brightness <3..100>    яркость матрицы в процентах
    victus-power measure [--dur S]      честный замер потребления батареи

Снимок прошлого состояния: /var/lib/victus-suite/power-state.json
Всё, что не поддерживается прошивкой/драйвером, пропускается с пометкой —
режим обязан работать на машине без единой ошибки «файл не найден».
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import subprocess
import sys
import time

TOOL = "victus-power"
STATE_DIR = "/var/lib/victus-suite"
STATE_FILE = os.path.join(STATE_DIR, "power-state.json")
CASCADE_FILE = os.path.join(STATE_DIR, "cascade.json")   # каскад 5..25 Вт

PLATFORM_PROFILE = "/sys/firmware/acpi/platform_profile"
PSTATE_DIR = "/sys/devices/system/cpu/intel_pstate"
RAPL = "/sys/class/powercap/intel-rapl:0"
DGPU_PCI = "0000:01:00.0"
HPWMI = "/sys/devices/platform/hp-wmi"
MUX_PATH = os.path.join(HPWMI, "gpu_mux_mode")

# «Печатная машинка»: значение каждого ручка. Отсутствующие пути = skip.
TYPEWRITER = {
    "platform_profile": ("path", PLATFORM_PROFILE, "low-power"),
    "no_turbo": ("path", os.path.join(PSTATE_DIR, "no_turbo"), "1"),
    "max_perf_pct": ("path", os.path.join(PSTATE_DIR, "max_perf_pct"), "40"),
    "rapl_pl1": ("path", os.path.join(RAPL, "constraint_0_power_limit_uw"),
                 "15000000"),
    "rapl_pl2": ("path", os.path.join(RAPL, "constraint_1_power_limit_uw"),
                 "30000000"),
    "dgpu_runtime": ("path", "/sys/bus/pci/devices/%s/power/control" % DGPU_PCI,
                     "auto"),
    # hybrid = iGPU рисует десктоп, dGPU только по запросу — максимум экономии
    "mux": ("path", MUX_PATH, "0"),
}
# ручки, которые повторяются на каждое ядро CPU
PER_CPU = (
    ("governor", "/sys/devices/system/cpu/cpu%d/cpufreq/scaling_governor",
     "powersave"),
    ("epp", "/sys/devices/system/cpu/cpu%d/cpufreq/energy_performance_preference",
     "power"),
    # Жёсткий потолок частоты: «печатной машинке» 4.7 ГГц не нужны.
    # Пишем ПОСЛЕ governor/EPP (иначе intel_pstate может перетереть), в снимок
    # идёт своё значение каждого ядра — P- и E-ядра тут разные.
    ("scaling_max_freq",
     "/sys/devices/system/cpu/cpu%d/cpufreq/scaling_max_freq",
     "1800000"),
)
# минимальный PL2, ниже которого BIOS уже не опускается
NVIDIA_PL_MIN_W = 20

# внешние утилиты: только фиксированные argv, без shell
IW = "/usr/bin/iw"
RFKILL = "/usr/bin/rfkill"

# --- честная модель расходов (замеры 03.10 на этом железе, батарея) ---------
# План = CPU (RAPL) + «плата» (экран, SoC вне ядра, радио, накопитель, VRM).
# Замерено от батареи окнами по 40 с: при 3% яркости плата ≈ 5.8–6.7 Вт,
# при 100% ≈ 9.9 Вт — то есть одна только подсветка матрицы даёт +3.6 Вт.
# Ползунок раньше двигал ТОЛЬКО CPU — поэтому «5 Вт» на экране означало
# «CPU ≤ 5 Вт», а ноут тянул 11–13 Вт. Теперь цель считается по всей системе.
# Оговорка: константы ниже — только ПЕРВЫЙ ШАГ плана. Дальше _stabilize
# замеряет живую плату (факт − RAPL) и считает по ней, поэтому ошибка
# модели не доходит до пользователя — до него доходит только измеренное.
PLATFORM_BASE_W = 5.4        # плата без CPU, Вт (серия 2026-10-03: 4.9–6.1)
BRIGHT_COST_W = 0.045        # Вт за 1% яркости (замер: 3%→65% = +3.6 Вт)
CPU_MIN_W = 3                # минимальный бюджет CPU: ниже машина вязнет


def platform_estimate(bright: int) -> float:
    """Ожидаемая плата (без CPU) при заданной яркости матрицы."""
    try:
        b = max(0, min(100, int(bright)))
    except (TypeError, ValueError):
        b = 8
    return round(PLATFORM_BASE_W + BRIGHT_COST_W * b, 2)


def kbd_bin() -> str:
    """victus-kbd лежит рядом с этим скриптом (install.sh кладёт оба в один
    каталог), с откатом на PATH."""
    here = os.path.dirname(os.path.realpath(__file__))
    cand = os.path.join(here, "victus-kbd")
    if os.path.exists(cand):
        return cand
    return "/home/bl/.local/bin/victus-kbd"


def kbd_state() -> bool | None:
    """power=on|off из `victus-kbd power` (без аргумента — печать состояния)."""
    try:
        proc = subprocess.run([kbd_bin(), "power"], capture_output=True,
                              text=True, timeout=6, check=False)
    except (OSError, subprocess.SubprocessError):
        return None
    text = "%s%s" % (proc.stdout or "", proc.stderr or "")
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("power="):
            return line.split("=", 1)[1].strip().lower() == "on"
    return None


def kbd_set(on: bool) -> str | None:
    """Включить/выключить подсветку клавиатуры. None = ок, иначе текст ошибки."""
    try:
        proc = subprocess.run([kbd_bin(), "power", "on" if on else "off"],
                              capture_output=True, text=True, timeout=8,
                              check=False)
    except (OSError, subprocess.SubprocessError) as exc:
        return str(exc)
    if proc.returncode != 0:
        return (proc.stderr or proc.stdout or "victus-kbd").strip()[:120]
    return None


def read(path: str):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return None


def write(path: str, value: str, attempts: int = 1, delay: float = 0.2):
    """Возвращает None при успехе, текст ошибки — при провале.

    intel_pstate «проглатывает» запись scaling_max_freq сразу после смены
    no_turbo/max_perf_pct: значение просто не меняется, но через доли секунды
    начинает приниматься (замер: до 2 попыток, 0.25 с). Без ретрая это был бы
    честный, но ложный отказ «все ядра отказали». Для обычных ручков
    attempts=1 — там мгновенный отказ означает реальную проблему.
    """
    if not os.path.exists(path):
        return "нет файла %s" % path
    last = None
    for attempt in range(max(1, int(attempts))):
        try:
            with open(path, "w") as fh:
                fh.write(value + "\n")
        except OSError as exc:
            last = "%s: %s" % (path, exc.strerror or exc)
        else:
            got = read(path)
            if got is None or got == value:
                return None
            last = "%s: прошивка отклонила %s (осталось %s)" % (path, value, got)
        if attempt + 1 < attempts:
            time.sleep(delay)
    return last


def cpu_ids() -> list[int]:
    ids = []
    for p in sorted(glob.glob("/sys/devices/system/cpu/cpu[0-9]*")):
        tail = os.path.basename(p)[3:]
        if tail.isdigit():
            ids.append(int(tail))
    return ids


# NB: вторая функция с этим именем ниже (_cap_freq_w) перекрыла бы эту —
# apply падал бы с TypeError. Разные задачи: здесь потолок на одно
# ядро, там — формула от ватт для ползунка.
def _cap_freq(cpu: int, want: str) -> str:
    """Не выше того, что ядро разрешает прямо сейчас.

    intel_pstate режет cpuinfo_max_freq по no_turbo/max_perf_pct; запись
    выше порога отклоняется целиком (не «обрезается»), и мы бы получили
    ложный отказ «все ядра отказали»."""
    info = read("/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq" % cpu)
    try:
        return str(min(int(want), int(info)))
    except (TypeError, ValueError):
        return want


def nvidia(args: list[str], timeout: float = 8.0):
    """Запуск nvidia-smi без shell; (rc, stdout) либо (None, причина)."""
    import shutil
    if not shutil.which("nvidia-smi"):
        return None, "nvidia-smi отсутствует"
    try:
        r = subprocess.run(["nvidia-smi"] + args, capture_output=True,
                           text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as exc:
        return None, str(exc)
    return r.returncode, (r.stdout or r.stderr or "").strip()


def _nvidia_limits() -> dict:
    """power.limit на выключенной дискретке отдаёт N/A — не верим вслепую."""
    rc, out = nvidia(["--query-gpu=power.limit,power.max_limit,persistence_mode",
                      "--format=csv,noheader,nounits"])
    res = {}
    if rc != 0 or not out:
        return res
    parts = [p.strip() for p in out.split(",")]
    for key, raw in (("power_limit", parts[0] if parts else None),
                     ("max_limit", parts[1] if len(parts) > 1 else None),
                     ("persistence_mode", parts[2] if len(parts) > 2 else None)):
        if raw is None:
            continue
        if key.endswith("limit"):
            try:
                res[key] = "%.1f" % float(raw.split()[0])
            except (ValueError, IndexError):
                pass
        elif raw and raw.lower() != "n/a":
            res[key] = raw
    # откатываемся на предел, если текущий неизвестен
    if "power_limit" not in res and "max_limit" in res:
        res["power_limit"] = res["max_limit"]
    return res


# ------------------------------------------------------ беспроводные модули
def _run(argv, timeout=6.0):
    """(rc, text) по фиксированному argv. Никакого shell, никаких аргументов
    извне — белый-лист вызовов, как и весь этот бинарник."""
    if not os.path.exists(argv[0]):
        return None, "нет %s" % argv[0]
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as exc:
        return None, str(exc)
    return r.returncode, (r.stdout or r.stderr or "").strip()


def wifi_ifaces() -> list:
    """Интерфейсы с /sys/class/net/<iface>/wireless (wlan0, wlo1, …)."""
    out = []
    for p in glob.glob("/sys/class/net/*/wireless"):
        parts = p.split(os.sep)
        if len(parts) >= 3:
            out.append(parts[-2])
    return sorted(set(out))


def wifi_get(iface: str):
    """'on'/'off' либо None (iw не отвечает / нет интерфейса)."""
    rc, out = _run([IW, "dev", iface, "get", "power_save"])
    if rc != 0:
        return None
    for line in (out or "").splitlines():
        tail = line.rsplit(":", 1)[-1].strip().lower()
        if tail in ("on", "off"):
            return tail
    return None


def wifi_set(iface: str, on: bool) -> str | None:
    want = "on" if on else "off"
    rc, out = _run([IW, "dev", iface, "set", "power_save", want])
    if rc != 0:
        return "iw: %s" % (out or "rc=%s" % rc)
    got = wifi_get(iface)
    if got is not None and got != want:
        return "iw применил не сразу (сейчас %s)" % got
    return None


def bt_soft():
    """'yes'/'no' (soft-block) либо None, если bluetooth-устройства нет."""
    rc, out = _run([RFKILL, "list", "bluetooth"])
    if rc != 0:
        return None
    for line in (out or "").splitlines():
        if "soft blocked" in line.lower():
            tail = line.rsplit(":", 1)[-1].strip().lower()
            if tail in ("yes", "no"):
                return tail
    return None


def bt_set(block: bool) -> str | None:
    rc, out = _run([RFKILL, "block" if block else "unblock", "bluetooth"])
    if rc != 0:
        return "rfkill: %s" % (out or "rc=%s" % rc)
    got = bt_soft()
    if got is not None and got != ("yes" if block else "no"):
        return "rfkill не подтвердил состояние (сейчас %s)" % got
    return None


def dgpu_runtime(wait: float = 0.0):
    """runtime_status дискретки: 'suspended' = она уже в Runtime D3."""
    path = "/sys/bus/pci/devices/%s/power/runtime_status" % DGPU_PCI
    if not wait:
        return read(path)
    end = time.monotonic() + wait
    while True:
        val = read(path)
        if val == "suspended" or time.monotonic() >= end:
            return val
        time.sleep(0.3)


# ------------------------------------------------------------------ snapshot
def snapshot() -> dict:
    """Текущее состояние всех ручков — для корректного отката."""
    snap = {"ts": time.time(), "knobs": {}, "per_cpu": {}, "nvidia": {}}
    for name, (_kind, path, _val) in TYPEWRITER.items():
        snap["knobs"][name] = read(path)
    for name, tmpl, _val in PER_CPU:
        snap["per_cpu"][name] = {
            "template": tmpl,
            "values": {str(i): read(tmpl % i) for i in cpu_ids()},
        }
    # Не будим спящую дискретку только ради того, чтобы записать её лимит:
    # усыпленная карта — результат, который мы и так добиваемся. Если она
    # уже проснулась — снимаем лимит, тогда apply сможет его снизить.
    if dgpu_runtime() == "suspended":
        snap["nvidia"] = {"_asleep": True}
    else:
        snap["nvidia"] = _nvidia_limits()
    # радио: что было ДО режима, чтобы restore вернул ровно это
    iface = (wifi_ifaces() or [None])[0]
    snap["wifi"] = {"iface": iface,
                    "power_save": wifi_get(iface) if iface else None}
    snap["bt"] = {"soft": bt_soft()}
    snap["dgpu_runtime"] = dgpu_runtime()
    return snap


def _write_snapshot(snap: dict) -> bool:
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(STATE_FILE, "w", encoding="utf-8") as fh:
            json.dump(snap, fh, ensure_ascii=False, indent=2)
        os.chmod(STATE_FILE, 0o600)
        return True
    except OSError as exc:
        print("%s: не смог сохранить снимок: %s" % (TOOL, exc), file=sys.stderr)
        return False


def save_snapshot() -> dict:
    snap = snapshot()
    _write_snapshot(snap)
    return snap


def looks_typewriter(knobs: dict) -> bool:
    """Похоже ли состояние на уже включённую «печатную машинку».

    Симптомы: выключен turbo, задавлен RAPL, прижат max_perf_pct или
    выбран тихий платформенный профиль. Один из них — достаточное
    подозрение, что мы смотрим НЕ baseline.
    """
    try:
        if str(knobs.get("no_turbo") or "") == "1":
            return True
        pl1 = int(float(str(knobs.get("rapl_pl1") or "0").split()[0]))
        if pl1 and pl1 <= 20000000:
            return True
        if int(float(str(knobs.get("max_perf_pct") or "100").split()[0])) <= 50:
            return True
    except (ValueError, TypeError):
        pass
    return str(knobs.get("platform_profile") or "") == "low-power"


def snapshot_now() -> dict:
    """Явно зафиксировать текущее состояние как точку отката.

    Нужен ОТДЕЛЬНОЙ командой: power-profiles-daemon меняет platform_profile и
    EPP сам, поэтому снимок обязан быть сделан ДО первого изменения, а не в
    момент apply (иначе в точку отката попадает уже «печатная машинка»).

    Две ловушки, которые иначе убивают откат:
      * существующий снимок перетирается текущим (часто уже изменённым)
        состоянием — restore начинает «возвращать» печатную машинку;
      * снимок снят с уже изменённой системы (ручной apply, падение TUI).
    Поэтому команда идемпотентна и отказывается работать с изменённой системой.
    """
    have = load_snapshot()
    if have is not None:
        return {"mode": "snapshot", "applied": [],
                "skipped": ["точка отката уже есть — не перетираю"],
                "failed": [], "knobs": have.get("knobs")}
    knobs = {name: read(path) for name, (_kind, path, _val) in TYPEWRITER.items()}
    if looks_typewriter(knobs):
        return {"mode": "snapshot", "applied": [], "skipped": [],
                "failed": ["система уже в режиме печатной машинки "
                           "(%s) — baseline не записан"
                           % ", ".join("%s=%s" % (k, v) for k, v in knobs.items()
                                       if v is not None and
                                       k in ("no_turbo", "rapl_pl1",
                                             "platform_profile"))],
                "knobs": knobs}
    snap = save_snapshot()
    return {"mode": "snapshot", "applied": ["точка отката сохранена"],
            "skipped": [], "failed": [], "knobs": snap.get("knobs")}


def load_snapshot():
    try:
        with open(STATE_FILE, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


# -------------------------------------------------------------------- actions
def apply_typewriter() -> dict:
    res = {"mode": "typewriter", "applied": [], "skipped": [],
           "failed": [], "restorable": True}
    targets = []                # (имя, путь, значение) — проверим после записи

    # Точка отката — состояние ДО первого включения. Повторный apply не должен
    # её затирать, иначе restore вернёт уже изменённые значения (low-power и т.п.)
    if load_snapshot() is None:
        snap = save_snapshot()
    else:
        snap = load_snapshot()

    for name, (_kind, path, value) in TYPEWRITER.items():
        cur = read(path)
        if cur is None:
            res["skipped"].append("%s: нет %s" % (name, path))
            continue
        if cur == value:
            res["applied"].append("%s=%s (уже так)" % (name, value))
            continue
        err = write(path, value)
        if err:
            res["failed"].append("%s: %s" % (name, err))
        else:
            res["applied"].append("%s=%s" % (name, value))
            targets.append((name, path, value))

    for name, tmpl, value in PER_CPU:
        ids = cpu_ids()
        if not ids:
            res["skipped"].append("%s: нет cpu*/cpufreq" % name)
            continue
        ok = bad = 0
        first_err = ""
        written = set()
        for i in ids:
            path = tmpl % i
            want = value
            if name == "scaling_max_freq":
                want = _cap_freq(i, value)
            if read(path) is None:
                continue
            # частотным ручкам нужен ретрай (см. write): intel_pstate
            # иногда не берёт запись сразу после no_turbo/max_perf_pct
            err = write(path, want, attempts=4)
            if err:
                bad += 1
                first_err = first_err or err
            else:
                ok += 1
                written.add(want)
                targets.append(("%s[cpu%d]" % (name, i), path, want))
        if ok:
            # ядра могут упираться в разные cpuinfo_max_freq — показываем
            # фактически выставленное, а не задуманное
            shown = written.pop() if len(written) == 1 else                 "%s..%s" % (min(written), max(written))
            res["applied"].append("%s=%s (%d cpu)" % (name, shown, ok))
        if bad:
            res["failed"].append("%s: %d ядер отказали%s"
                                 % (name, bad, " — %s" % first_err[:90]
                                    if first_err else ""))
        if not ok and not bad:
            res["skipped"].append("%s: нет %s" % (name, tmpl % 0))

    # NVIDIA: persistence off + потолок мощности (дискретка уходит в сон,
    # а если проснётся — ей разрешено только %d Вт).
    # Команды пропускаются, когда результат был бы тождественным: каждый
    # вызов nvidia-smi будит дискретку, ради которой мы всё и делаем.
    saved = (snap.get("nvidia") or {})
    if saved.get("_asleep"):
        res["skipped"].append(
            "nvidia: дискретка была в Runtime D3 — persistence/лимит не трогали")
    elif str(saved.get("persistence_mode") or "").strip().lower() in ("0", "off",
                                                                      "disabled"):
        res["applied"].append("nvidia persistence=0 (уже так)")
    else:
        rc, out = nvidia(["-pm", "0"])
        if rc is None:
            res["skipped"].append("nvidia: нет nvidia-smi")
        elif rc != 0 or _nvidia_warn(out):
            res["failed"].append("nvidia: не смог выключить persistence mode (%s)"
                                 % (out or "rc=%s" % rc).strip()[:80])
        else:
            res["applied"].append("nvidia persistence=0")
    try:
        cur_pl = float((saved.get("power_limit") or "0").split()[0])
    except (ValueError, AttributeError, IndexError):
        cur_pl = 0.0
    target = min(cur_pl, NVIDIA_PL_MIN_W) or NVIDIA_PL_MIN_W
    if saved.get("_asleep") or not cur_pl:
        pass                                # уже пропущено/нет данных
    elif cur_pl <= NVIDIA_PL_MIN_W:
        # снимок говорит, что лимит и так не выше потолка — трогать нечего
        res["applied"].append("nvidia power_limit=%.0fW (уже так)" % cur_pl)
    else:
        rc, out = nvidia(["-pl", "%.1f" % target])
        if rc is None:
            pass
        elif rc != 0 or _nvidia_warn(out):
            # драйвер отвечает rc=0 и текстом «not supported» — это не успех
            res["skipped"].append("nvidia -pl: %s"
                                  % ((out or "отказ").strip().splitlines()[:1])[0][:90])
        else:
            res["applied"].append("nvidia power_limit=%.0fW" % target)
            # restore обязан вернуть лимит, даже если к тому моменту дискретка
            # уже уснула — иначе пропустим восстановление «по спящей»
            snap.setdefault("nvidia", {})["_pl_changed"] = True
            _write_snapshot(snap)

    # --- беспроводные модули: wifi power-save + bluetooth rfkill -----------
    iface = (wifi_ifaces() or [None])[0]
    if not iface:
        res["skipped"].append("wifi: нет беспроводного интерфейса")
    else:
        err = wifi_set(iface, True)
        res["applied" if err is None else "failed"].append(
            "wifi power_save=on (%s)" % iface if err is None
            else "wifi: %s" % err)
    if bt_soft() is None:
        res["skipped"].append("bluetooth: устройства rfkill не найдено")
    else:
        err = bt_set(True)
        res["applied" if err is None else "failed"].append(
            "bluetooth soft-block (rfkill)" if err is None
            else "bluetooth: %s" % err)

    # EC имеет право перетереть наши записи (platform_profile, например,
    # возвращает RAPL к своим 55 Вт) — перечитываем и честно рапортуем.
    if targets:
        time.sleep(1.0)
        for name, path, value in targets:
            got = read(path)
            if got != value:
                res["applied"] = [a for a in res["applied"]
                                  if not a.startswith(name.split("[")[0] + "=")]
                res["failed"].append("%s: прошивка откатила %s (вернулось %s)"
                                     % (name, value, got))

    # --- дискретка: дождаться Runtime D3 --------------------------------------
    # nvidia-smi поднимает карту на 5–15 с, поэтому ждём недолго: даже если
    # не успели, держатели (Hyprland, voxtype) НЕ мешают усыпанию — карта
    # уходит в Runtime D3 сама после idle-таймаута, и вкладка показывает это.
    runtime = dgpu_runtime(wait=4.0)
    if runtime == "suspended":
        res["applied"].append("dGPU runtime=suspended (Runtime D3)")
    elif runtime is None:
        res["skipped"].append("dGPU: нет sysfs питания на %s" % DGPU_PCI)
    else:
        res["skipped"].append(
            "dGPU ещё %s — уйдёт в Runtime D3 сама после idle" % runtime)

    res["snapshot"] = bool(snap)
    res["dgpu_runtime"] = runtime
    return res


def _nvidia_warn(out) -> bool:
    """nvidia-smi возвращает rc=0 даже когда ничего не сделал."""
    text = (out or "").lower()
    return any(s in text for s in ("not supported", "not supported for",
                                   "[n/a]", "invalid", "failed"))


def _cap_plan(w: int):
    """Потолок w Вт на ВЕСЬ компьютер, а не только на PL1.

    План: PL1/PL2 (буст и многопоточность), max_perf_pct (потолок
    интела по производительности) и потолок частоты на каждом ядре.
    Плюс дискретка — она обязана уйти в Runtime D3, иначе один только
    она съедает больше, чем весь бюджет.
    """
    return (
        ("rapl_pl1", os.path.join(RAPL, "constraint_0_power_limit_uw"),
         str(w * 1_000_000), "%.0f Вт" % w),
        ("rapl_pl2", os.path.join(RAPL, "constraint_1_power_limit_uw"),
         str(w * 2_000_000), "%.0f Вт" % (w * 2)),
        ("max_perf_pct", os.path.join(PSTATE_DIR, "max_perf_pct"),
         str(20 + (w - 5) * 2), "%d %%" % (20 + (w - 5) * 2)),
        ("dgpu_runtime", "/sys/bus/pci/devices/%s/power/control" % DGPU_PCI,
         "auto", "auto (Runtime D3)"),
    )


def _cap_freq_w(w: int) -> int:
    """Потолок частоты под бюджет: 5 Вт → 1.0 ГГц, 15 → 1.8, 25 → 2.6."""
    return 1_000_000 + (w - 5) * 80_000


def draw(dur: float = 1.2) -> dict:
    """Живая мощность пакета CPU: энергия RAPL за интервал / время.

    Зачем: `power_now` батареи отдаёт ЭС промеженный, ступенчатый сигнал
    (19.5 → 25 Вт уже ПОСЛЕ снятия нагрузки) — по нему видно только то,
    что было несколько секунд назад. RAPL считает реальную энергию ядра,
    поэтому цифра реагирует на перетаскивание ползунка мгновенно.
    """
    res = {"mode": "draw", "dur": 0.0}
    path = os.path.join(RAPL, "energy_uj")
    try:
        a = int(str(read(path) or "").strip())
    except (TypeError, ValueError):
        a = None
    if a is None:
        res["failed"].append("draw: нет %s" % path)
        return res
    t0 = time.monotonic()
    time.sleep(max(0.3, min(5.0, float(dur or 1.2))))
    dt = time.monotonic() - t0
    try:
        b = int(str(read(path) or "").strip())
    except (TypeError, ValueError):
        b = None
    if b is None or dt <= 0:
        res["failed"].append("draw: не удалось прочитать энергию")
        return res
    if b < a:                      # переполнение счётчика — интервал не берём
        res["skipped"].append("draw: счётчик энергии переполнился")
        return res
    res["dur"] = round(dt, 2)
    res["cpu_w"] = round((b - a) / 1e6 / dt, 2)
    pl1 = read(os.path.join(RAPL, "constraint_0_power_limit_uw"))
    try:
        res["pl1_w"] = round(int(str(pl1).split()[0]) / 1e6, 1)
    except (TypeError, ValueError, AttributeError):
        res["pl1_w"] = None
    res["no_turbo"] = read(os.path.join(PSTATE_DIR, "no_turbo"))
    try:
        res["max_freq_mhz"] = int(int(read(
            "/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq")) / 1000)
    except (TypeError, ValueError, AttributeError):
        res["max_freq_mhz"] = None
    return res


def set_watts(watt) -> dict:
    """Потолок мощности 3..25 Вт на пакет CPU — только при включённой
    «печатной машинке» (проверка и здесь, а не только в UI).

    3 Вт — дно для каскада на цель 5–6 Вт: платы и так уходит ~5.5 Вт,
    поэтому бюджет CPU там должен быть минимальным, а не «как обычно 5».
    """
    res = {"mode": "watts", "applied": [], "skipped": [], "failed": [],
           "restorable": False}
    try:
        w = int(watt)
    except (TypeError, ValueError):
        res["failed"].append("watts: не число %r" % (watt,))
        return res
    if not 3 <= w <= 25:
        res["failed"].append("watts: %d вне диапазона 3..25" % w)
        return res

    knobs = {
        "no_turbo": read(os.path.join(PSTATE_DIR, "no_turbo")),
        "rapl_pl1": read(os.path.join(RAPL, "constraint_0_power_limit_uw")),
        "max_perf_pct": read(os.path.join(PSTATE_DIR, "max_perf_pct")),
    }
    if not looks_typewriter(knobs):
        res["failed"].append(
            "режим выключен: ползунок мощности действует только при "
            "включённой печатной машинке")
        return res

    for key, path, want, shown in _cap_plan(w):
        if read(path) is None:
            res["skipped"].append("%s: нет %s" % (key, path))
            continue
        err = write(path, want, attempts=4, delay=0.2)
        if err:
            res["failed"].append("%s: %s" % (key, err))
            continue
        cur = read(path)
        if cur == want:
            res["applied"].append("%s=%s" % (key, shown))
            continue
        if key == "max_perf_pct" and cur is not None and int(cur) >= int(want):
            res["applied"].append("%s=%s%% (держит %s)"
                                  % (key, shown.split()[0], cur))
            continue
        res["failed"].append("%s: держит %s, ждали %s" % (key, cur, want))

    # частота — на каждое ядро, но никогда выше его собственного
    # cpuinfo_max_freq: E-ядра на этом железе кончаются на 1.9 ГГц
    freq_want = _cap_freq_w(w)
    cores = sorted(glob.glob(
        "/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_max_freq"))
    if not cores:
        res["skipped"].append("частоты: cpufreq не найден")
    else:
        ok, bad, clamped = 0, 0, 0
        for path in cores:
            base = path.rsplit("/", 1)[0]
            cap = read(os.path.join(base, "cpuinfo_max_freq"))
            try:
                want = min(freq_want, int(cap))
            except (TypeError, ValueError):
                want = freq_want
            if want < freq_want:
                clamped += 1
            if read(path) is None:
                bad += 1
                continue
            err = write(path, str(want), attempts=4, delay=0.2)
            got = read(path)
            if not err and got is not None and int(got) == want:
                ok += 1
            else:
                bad += 1
                if err:
                    res["failed"].append("частота %s: %s" % (base, err))
        line = "частота до %.2f ГГц на %d/%d ядрах" % (
            freq_want / 1e6, ok, len(cores))
        if clamped:
            line += " (%d упёрлись в свой максимум)" % clamped
        (res["failed"] if bad else res["applied"]).append(line)

    # дискретка обязана уснуть: она одинаково жрёт и в покое, и под нагрузкой
    runtime = dgpu_runtime(wait=4.0)
    if runtime == "suspended":
        res["applied"].append("dGPU suspended (0 Вт)")
    elif runtime is None:
        res["skipped"].append("dGPU: нет runtime_status")
    else:
        res["skipped"].append(
            "dGPU ещё %s — уйдёт в Runtime D3 сама после idle" % runtime)
    return res


def _backlight_path():
    hits = sorted(glob.glob("/sys/class/backlight/*/brightness"))
    return hits[0] if hits else None


def brightness(pct=None) -> dict:
    """Яркость матрицы в процентах (без pct — только прочитать).

    Нужна каскаду: на матрицу уходит 4–5 Вт, и без её регулировки
    потолок «5 Вт на весь ноутбук» недостижим физически.
    """
    res = {"mode": "brightness", "applied": [], "failed": [], "skipped": []}
    path = _backlight_path()
    if not path:
        res["failed"].append("яркость: нет /sys/class/backlight/*/brightness")
        return res
    mx = None
    try:
        mx = int(str(read(os.path.join(os.path.dirname(path),
                                       "max_brightness")) or "").split()[0])
    except (TypeError, ValueError, IndexError):
        pass
    if not mx:
        res["failed"].append("яркость: не прочитан max_brightness")
        return res
    cur = read(path)
    try:
        res["pct"] = round(int(str(cur).split()[0]) * 100 / mx)
    except (TypeError, ValueError, IndexError):
        res["pct"] = None
    if pct is None:
        return res
    try:
        want_pct = int(pct)
    except (TypeError, ValueError):
        res["failed"].append("яркость: не число %r" % (pct,))
        return res
    want_pct = max(3, min(100, want_pct))
    err = write(path, str(mx * want_pct // 100), attempts=4, delay=0.2)
    if err:
        res["failed"].append("яркость: %s" % err)
        return res
    res["applied"].append("яркость %d%%" % want_pct)
    res["pct"] = want_pct
    return res


def _usb_save() -> dict:
    """Снимок USB-экономии, чтобы cascade-off вернул как было."""
    out = {"global": read("/sys/module/usbcore/parameters/autosuspend"),
           "devs": {}}
    for d in glob.glob("/sys/bus/usb/devices/*"):
        if not os.path.exists(os.path.join(d, "idVendor")):
            continue
        try:
            vid = str(read(os.path.join(d, "idVendor"))).strip()
        except (TypeError, ValueError):
            vid = ""
        if vid == "1d6b":                       # корневые хабы не трогаем
            continue
        out["devs"][d] = {
            "control": read(os.path.join(d, "power/control")),
            "delay": read(os.path.join(d, "power/autosuspend_delay_ms")),
        }
    return out


def _usb_apply(ms: int) -> list:
    """USB autosuspend — та же логика, что у ppd-power-actions (не воюем)."""
    steps, fail = [], []
    write("/sys/module/usbcore/parameters/autosuspend", str(ms // 1000))
    for d in glob.glob("/sys/bus/usb/devices/*"):
        vid_path = os.path.join(d, "idVendor")
        if not os.path.exists(vid_path):
            continue
        try:
            vid = str(read(vid_path)).strip()
        except (TypeError, ValueError):
            continue
        if vid == "1d6b":
            continue
        # BT-комбо держим живым (та же маска, что у ppd-power-actions)
        try:
            pid = str(read(os.path.join(d, "idProduct"))).strip()
        except (TypeError, ValueError):
            pid = ""
        if "%s:%s" % (vid, pid) == "13d3:3567":
            continue
        if read(os.path.join(d, "power/control")) is None:
            continue
        if write(os.path.join(d, "power/control"), "auto") or write(
                os.path.join(d, "power/autosuspend_delay_ms"), str(ms)):
            fail.append(os.path.basename(d))
        else:
            steps.append(os.path.basename(d))
    if not steps and not fail:
        return []
    return ["usb autosuspend %d мс (%d устр.)" % (ms, len(steps))]


def _usb_restore(snap: dict) -> list:
    out = []
    if snap.get("global") is not None:
        write("/sys/module/usbcore/parameters/autosuspend", str(snap["global"]))
        out.append("usb global=%s" % snap["global"])
    for d, vals in (snap.get("devs") or {}).items():
        if vals.get("control"):
            write(os.path.join(d, "power/control"), str(vals["control"]))
        if vals.get("delay"):
            write(os.path.join(d, "power/autosuspend_delay_ms"), str(vals["delay"]))
    return out


def _rfkill(block: bool) -> tuple:
    act = "block" if block else "unblock"
    try:
        proc = subprocess.run(["rfkill", act, "bluetooth"],
                              capture_output=True, text=True, timeout=6.0)
    except (OSError, subprocess.SubprocessError) as exc:
        return False, str(exc)
    return proc.returncode == 0, proc.stderr.strip()


def _wifi_ps(on: bool) -> tuple:
    iface = None
    for name in ("/sys/class/net/wlo1", "/sys/class/net/wlan0"):
        if os.path.exists(name):
            iface = os.path.basename(name)
            break
    if not iface:
        for line in glob.glob("/sys/class/net/*"):
            if os.path.exists(os.path.join(line, "wireless")):
                iface = os.path.basename(line)
                break
    if not iface:
        return False, "нет wifi-интерфейса"
    try:
        proc = subprocess.run(["iw", "dev", iface, "set", "power_save",
                               "on" if on else "off"],
                              capture_output=True, text=True, timeout=6.0)
    except (OSError, subprocess.SubprocessError) as exc:
        return False, str(exc)
    return proc.returncode == 0, proc.stderr.strip()


def _cascade_read() -> dict:
    try:
        with open(CASCADE_FILE, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def _cascade_write(data: dict) -> None:
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(CASCADE_FILE, "w", encoding="utf-8") as fh:
            json.dump(data, fh, ensure_ascii=False, indent=1)
        os.chmod(CASCADE_FILE, 0o600)
    except OSError:
        pass


def cascade_plan(target, cpu=None) -> dict:
    """План каскада: цель T Вт — на ВЕСЬ ноутбук, а не только на CPU.

    Модель (замеры 03.10 на этом железе, окна по 40 с от батареи, RAPL
    считался отдельно): плата = 5.5 Вт на 0% яркости + 0.045 Вт за каждый
    процент подсветки. Раньше ползунок двигал только CPU, поэтому «5 Вт»
    на экране означало «CPU ≤ 5 Вт», а ноут тял 11–13 Вт (CPU ~5 + плата ~6).

    Теперь: у платы забираем её долю (ярус по яркости), остаток идёт CPU
    и никогда не опускается ниже CPU_MIN_W. Цели ниже физического минимума
    отмечаются как недостижимые — честно, а не «5 Вт» на экране.
    """
    t = int(target)
    if not 5 <= t <= 25:
        raise ValueError("цель %d вне диапазона 5..25" % t)

    # ярус каскада: чем ниже цель, тем злее гасим
    if t <= 6:
        tier = {"bright": 3, "bt": True, "usb": 2000, "slow": True,
                "kbd": False}
    elif t <= 8:
        tier = {"bright": 5, "bt": True, "usb": 2000, "slow": True,
                "kbd": False}
    elif t <= 10:
        tier = {"bright": 8, "bt": True, "usb": 2000, "slow": True,
                "kbd": False}
    elif t <= 13:
        tier = {"bright": 12, "bt": True, "usb": 2000, "slow": True,
                "kbd": False}
    elif t <= 17:
        tier = {"bright": 20, "bt": True, "usb": 2000, "slow": False,
                "kbd": True}
    elif t <= 20:
        tier = {"bright": 35, "bt": False, "usb": None, "slow": False,
                "kbd": True}
    else:
        tier = {"bright": 55, "bt": False, "usb": None, "slow": False,
                "kbd": True}

    overhead = platform_estimate(tier["bright"])
    # целое: set_watts/pl1 ждут ватты-целые, а `_cap_freq_w` строит по ним
    # частоту — дробные 4.24 Вт сюда попадать не должны
    ceiling = int(max(CPU_MIN_W, min(25, round(t - overhead))))
    if cpu is not None:
        # --cpu: ручной жёсткий потолок (не ниже CPU_MIN_W, чтобы TUI не вяз)
        ceiling = max(CPU_MIN_W, min(25, int(cpu)))

    plan = dict(tier)
    plan.update(
        target=t,
        cpu=ceiling,
        freq=_cap_freq_w(ceiling),
        wifi=True,                       # только power-save, сеть не рвём
        overhead=overhead,               # ожидаемая плата при этой яркости
        expect_w=round(ceiling + overhead, 1),   # ожидаемый итог при загрузке
        min_w=round(CPU_MIN_W + overhead, 1),    # физический минимум плана
        feasible=bool(t >= CPU_MIN_W + overhead - 0.5),
        steps=[],
    )
    return plan


def measure_total(dur: float = 8.0) -> dict:
    """Честный замер потребления ВСЕЙ системы от батареи.

    Источник — падение `energy_now` за окно (µWh → Вт): это единственный
    сигнал, который видит и экран, и плату, и CPU, и радио. `power_now`
    берём только как перекрёстную проверку — он ступенчатый и отстаёт.
    На зарядке измерять нечего: `power_now` показывает ток зарядки, а не
    расход, поэтому честно отказываемся, а не врём цифрой.
    """
    dur = max(3.0, min(60.0, float(dur or 8.0)))
    bat = (sorted(glob.glob("/sys/class/power_supply/BAT*")) or [None])[0]
    if not bat:
        return {"ok": False, "reason": "нет батареи"}
    status = (read(os.path.join(bat, "status")) or "").strip()
    if "discharg" not in status.lower():
        return {"ok": False, "reason": "зарядка — расход не меряется",
                "status": status}

    def _num(path):
        try:
            return float(str(read(path) or "").split()[0])
        except (TypeError, ValueError, AttributeError):
            return None

    e0 = _num(os.path.join(bat, "energy_now"))
    p0 = _num(os.path.join(bat, "power_now"))
    t0 = time.monotonic()
    samples = []
    while time.monotonic() - t0 < dur:
        p = _num(os.path.join(bat, "power_now"))
        if p:
            samples.append(p)
        time.sleep(1.0)
    e1 = _num(os.path.join(bat, "energy_now"))
    dt = time.monotonic() - t0

    out = {"ok": False, "dur": round(dt, 1), "status": status,
           "at": round(time.time(), 1)}
    energy_w = pnow_w = None
    if e0 is not None and e1 is not None and e0 > e1 and dt > 0:
        # µWh за окно → Вт:  W = dE_µWh * 3600 / (1e6 * dt_с)
        energy_w = round((e0 - e1) * 3600.0 / (1e6 * dt), 2)
        out["delta_uwh"] = round(e0 - e1, 1)
    if samples:
        pnow_w = round(sum(samples) / len(samples) / 1e6, 2)
        out["pnow_avg"] = pnow_w
        out["pnow_min"] = round(min(samples) / 1e6, 2)
    if p0:
        out["pnow0"] = round(p0 / 1e6, 2)
    # ВАЖНО: шкала energy_now шагает по 10 мWh — на окне 30 с это шаг
    # 1.2 Вт (мы одно время «мерили» 4.5 Вт там, где ноут тянет 9, и из-за
    # этого цели ложно «не брались»). Среднее power_now за то же окно в
    # четырёх перекрёстных замерах совпало с последующим 40-секундным
    # окном лучше, чем интеграл (10.6 vs 10.8 / 10.0 vs 10.8 / 8.9 vs 7.2
    # / 8.6 vs 9.6), поэтому:
    #   окно ≥60 с  → энергия (интеграл, погрешность <0.5 Вт);
    #   короче      → среднее power_now, энергия остаётся сверкой.
    if energy_w is not None and dt >= 60.0:
        out["w"], out["method"] = energy_w, "energy"
    elif pnow_w is not None:
        out["w"], out["method"] = pnow_w, "power_now"
    elif energy_w is not None:
        out["w"], out["method"] = energy_w, "energy-short"
    if out.get("w") is not None:
        out["ok"] = True
    out["w_energy"], out["w_pnow"] = energy_w, pnow_w
    if energy_w is not None and pnow_w is not None and \
            abs(energy_w - pnow_w) > 1.5:
        out["note"] = ("энергия %.1f Вт за %.0f с, power_now %.1f Вт — "
                       "шкала датчика, не расхождение системы"
                       % (energy_w, dt, pnow_w))
    if not out.get("ok"):
        out["reason"] = out.get("reason") or "энергия не падала (зарядка?)"
    return out


def cascade_apply(target, cpu=None, stabilize: bool = True,
                  dur: float = 30.0) -> dict:
    """Каскад на цель T Вт: CPU-потолок + экран + радио + USB + подсветка.

    После применения система ЗАМЕРЯЕТСЯ от батареи и, если факт выше цели
    больше чем на ватт, бюджет CPU стягивается вниз (до CPU_MIN_W) и замер
    повторяется. Итог кладётся в res["measure"]: цель, факт, плата — честно.
    """
    res = {"mode": "cascade", "applied": [], "skipped": [], "failed": [],
           "steps": [], "plan": None, "restorable": False}
    try:
        plan = cascade_plan(target, cpu)
    except ValueError as exc:
        res["failed"].append("cascade: %s" % exc)
        return res
    res["plan"] = plan

    knobs = {
        "no_turbo": read(os.path.join(PSTATE_DIR, "no_turbo")),
        "rapl_pl1": read(os.path.join(RAPL, "constraint_0_power_limit_uw")),
        "max_perf_pct": read(os.path.join(PSTATE_DIR, "max_perf_pct")),
    }
    if not looks_typewriter(knobs):
        res["failed"].append(
            "режим выключен: каскад действует только при включённой "
            "печатной машинке")
        return res

    prev = _cascade_read() or {}
    prev.setdefault("bt_blocked", False)
    prev.setdefault("brightness", None)

    # --- 1. CPU + дискретка (готовая логика watts) -------------------------
    w = set_watts(plan["cpu"])
    res["applied"] += w.get("applied", [])
    res["skipped"] += w.get("skipped", [])
    res["failed"] += w.get("failed", [])
    res["steps"].append({"key": "cpu", "cpu": plan["cpu"], "freq": plan["freq"]})

    # --- 2. экран ----------------------------------------------------------
    if prev.get("brightness") is None:
        b = brightness()
        prev["brightness"] = b.get("pct")
    b = brightness(plan["bright"])
    if b.get("failed"):
        res["failed"] += b["failed"]
    else:
        res["applied"] += b["applied"]
        res["steps"].append({"key": "screen", "bright": plan["bright"]})

    # --- 3. радио ----------------------------------------------------------
    if not plan["bt"] and prev.get("bt_blocked"):
        ok, err = _rfkill(False)
        if ok:
            prev["bt_blocked"] = False
            res["applied"].append("bluetooth unblocked")
        else:
            res["skipped"].append("bluetooth: %s" % (err or "rfkill"))
    if plan["bt"]:
        ok, err = _rfkill(True)
        if ok:
            prev["bt_blocked"] = prev.get("bt_blocked") or True
            res["applied"].append("bluetooth blocked")
            res["steps"].append({"key": "bt"})
        else:
            res["skipped"].append("bluetooth: %s" % (err or "rfkill"))
    if plan["wifi"]:
        ok, err = _wifi_ps(True)
        if ok:
            res["applied"].append("wifi power_save on")
            res["steps"].append({"key": "wifi"})
        else:
            res["skipped"].append("wifi: %s" % (err or "iw"))

    # --- 4. подсветка клавиатуры корпуса -----------------------------------
    # До этого её гасили только руками: EC держал 100% яркости и жрал
    # ватты даже на цели 5 Вт. Состояние до каскада запоминаем один раз.
    was_kbd = prev.get("kbd_power")
    if was_kbd is None:
        was_kbd = kbd_state()
        prev["kbd_power"] = was_kbd
    if not plan["kbd"]:
        if was_kbd:
            err = kbd_set(False)
            if err:
                res["skipped"].append("подсветка клавиатуры: %s" % err)
            else:
                res["applied"].append("подсветка клавиатуры выкл")
                res["steps"].append({"key": "kbd"})
    elif was_kbd:
        err = kbd_set(True)               # более мягкий ярус — возвращаем свет
        if not err:
            res["steps"].append({"key": "kbd_on"})

    # --- 5. USB ------------------------------------------------------------
    if not plan["usb"] and prev.get("usb"):
        res["applied"] += _usb_restore(prev["usb"])
        prev["usb"] = None
    if plan["usb"]:
        if prev.get("usb") is None:
            prev["usb"] = _usb_save()
        lines = _usb_apply(plan["usb"])
        res["applied"] += lines
        if lines:
            res["steps"].append({"key": "usb"})

    # --- 6. фон: свои же опросы --------------------------------------------
    if plan["slow"]:
        res["steps"].append({"key": "slow"})

    res["steps"].append({"key": "dgpu"})
    prev.update(plan=plan, cpu=plan["cpu"], target=plan["target"],
                slow=bool(plan["slow"]))
    if stabilize:
        res["measure"] = _stabilize(res, prev, plan, dur)
    _cascade_write(prev)
    res["restorable"] = True
    return res


def _stabilize(res: dict, prev: dict, plan: dict, dur: float) -> dict:
    """Замер факта от батареи и подтяжка CPU к цели.

    Ползунок обещает число ВСЕЙ системы — значит после применения мы обязаны
    измерить, сколько ноут тянет на самом деле, и стянуть бюджет CPU, пока
    факт выше цели больше чем на ватт.

    Порядок важен:
      1. спим 4 с: сразу после записи (яркость, rfkill, usb, PL1) система
         вспыхивает, и окно ловит 13 Вт вместо настоящих 9 — раньше из-за
         этого цели «не брались» и в отчёт уходил вымысел;
      2. меряем факт и ЦИФРАМИ ЖЕЛЕЗА вычисляем живую плату (факт − RAPL);
         по ней пересчитываем минимум плана и бюджет CPU — модель больше
         не врёт, её корректирует сам замер;
      3. ужимаем CPU не дальше CPU_MIN_W, максимум 2 шага за вызов;
      4. цель ниже физического минимума — честно (feasible=False + min_w),
         а не красивая ложь.
    """
    time.sleep(4.0)                      # дать системе успокоиться
    meas = measure_total(dur)
    if not meas.get("ok"):
        # причина (зарядка / нет батареи) печатается в emit — второй раз
        # дублировать её в skipped не надо
        meas.update(target=plan["target"], cpu=plan["cpu"],
                    expect_w=plan["expect_w"], min_w=plan["min_w"],
                    feasible=plan["feasible"], trimmed=0)
        return meas

    trimmed = 0
    for _pass in range(3):
        target = plan["target"]
        w = meas.get("w")
        rapl = draw(1.0).get("cpu_w")

        # живая плата = факт − CPU: единственный честный ориентир
        platform = None
        if w is not None and rapl is not None:
            platform = max(0.0, w - rapl)
            plan["overhead"] = round(platform, 2)
            plan["min_w"] = round(platform + CPU_MIN_W, 1)
            plan["feasible"] = bool(target >= plan["min_w"] - 1.0)

        if w is None or w <= target + 1.0:
            break                         # цель взята — ужимать нечего
        if plan["cpu"] <= CPU_MIN_W:
            break                         # минимум уже, плата не даёт

        want = max(CPU_MIN_W, int(target - (platform or plan["overhead"])))
        new_cpu = max(CPU_MIN_W, min(plan["cpu"] - 1, want))
        if new_cpu >= plan["cpu"]:
            break                         # шага вниз не осталось
        plan["cpu"] = new_cpu
        plan["freq"] = _cap_freq_w(new_cpu)
        plan["expect_w"] = round(new_cpu + plan["overhead"], 1)
        wres = set_watts(new_cpu)
        res["failed"] += wres.get("failed", [])
        res["applied"] += wres.get("applied", [])
        res["steps"] = [s if s.get("key") != "cpu" else
                        {"key": "cpu", "cpu": new_cpu,
                         "freq": plan["freq"]} for s in res["steps"]]
        trimmed += 1
        time.sleep(4.0)                   # дать ЭС догнать
        meas = measure_total(dur)
        if not meas.get("ok"):
            break

    d = draw(1.0)
    if d.get("cpu_w") is not None:
        meas["rapl_w"] = d["cpu_w"]
        if meas.get("w") is not None:
            meas["platform_w"] = round(meas["w"] - d["cpu_w"], 2)
    # допуск на «цель взята» — 0.7 Вт: шире, и 9.0 Вт при цели 8 Вт
    # называется успехом, а это ровно та ложь, с которой мы и боремся
    tol = 0.7
    meas.update(target=plan["target"], cpu=plan["cpu"],
                expect_w=plan["expect_w"], min_w=plan["min_w"],
                feasible=bool(plan["feasible"] and
                              meas.get("w", 1e9) <= plan["target"] + tol),
                trimmed=trimmed, slow=bool(plan["slow"]))
    if meas.get("w") is not None:
        if meas["w"] <= plan["target"] + tol:
            res["applied"].append("факт %.1f Вт — цель %.0f Вт взята"
                                  % (meas["w"], plan["target"]))
        else:
            res["skipped"].append(
                "факт %.1f Вт при цели %.0f Вт (минимум %.1f Вт, CPU %.0f Вт)"
                % (meas["w"], plan["target"], plan["min_w"], plan["cpu"]))
    prev["measure"] = meas
    return meas


def cascade_off() -> dict:
    """Снять каскад: вернуть яркость, подсветку клавиатуры, BT, USB, фон."""
    res = {"mode": "cascade-off", "applied": [], "skipped": [], "failed": []}
    prev = _cascade_read()
    if not prev:
        res["skipped"].append("каскад не включён")
        return res
    if prev.get("brightness") is not None:
        b = brightness(prev["brightness"])
        res["applied"] += b.get("applied", [])
        res["failed"] += b.get("failed", [])
    if prev.get("kbd_power"):
        err = kbd_set(True)               # свет клавиатуры, как и был
        (res["failed"] if err else res["applied"]).append(
            "подсветка клавиатуры вкл" if not err else "подсветка: %s" % err)
    if prev.get("bt_blocked"):
        ok, err = _rfkill(False)
        (res["applied"] if ok else res["failed"]).append(
            "bluetooth unblocked" if ok else "bluetooth: %s" % err)
    if prev.get("usb"):
        res["applied"] += _usb_restore(prev["usb"])
    try:
        os.remove(CASCADE_FILE)
    except OSError:
        pass
    res["applied"].append("каскад снят (CPU-потолки остались)")
    return res


def restore() -> dict:
    # каскад трогал яркость/радио/USB — снимаем его первым, иначе
    # после отката останется тусклый экран и выключенный Bluetooth
    if os.path.exists(CASCADE_FILE):
        cascade_off()
    snap = load_snapshot()
    if not snap:
        return {"mode": "restore", "applied": [], "skipped": [],
                "failed": ["снимок %s не найден — откатывать нечего"
                           % STATE_FILE]}
    res = {"mode": "restore", "applied": [], "skipped": [], "failed": []}

    # ПОРЯДОК ОБРАТНЫЙ К apply и это важно: сначала «глобальные» ручки
    # (no_turbo, max_perf_pct, platform_profile) — они возвращают ядрам
    # полный диапазон частот, иначе intel_pstate не примет запись
    # scaling_max_freq из снимка и откат был бы неполным.
    saved_knobs = snap.get("knobs") or {}
    for name, (_kind, path, _val) in TYPEWRITER.items():
        val = saved_knobs.get(name)
        if val is None:
            res["skipped"].append("%s: в снимке пусто" % name)
            continue
        if read(path) is None:
            res["skipped"].append("%s: нет %s" % (name, path))
            continue
        if read(path) == val:
            continue                # MUX, например, отдаёт EINVAL на тот же бит
        err = write(path, val)
        (res["failed"] if err else res["applied"]).append(
            "%s=%s" % (name, val) if not err else err)

    for name, data in (snap.get("per_cpu") or {}).items():
        tmpl = data.get("template")
        for idx, val in (data.get("values") or {}).items():
            if not tmpl or val is None:
                continue
            path = tmpl % int(idx)
            if read(path) is None:
                res["skipped"].append(path)
                continue
            if read(path) == val:
                continue            # уже в прошлом состоянии — не дёргаем прошивку
            # тот же ретрай, что при включении: частоты не всегда
            # берутся с первого раза
            err = write(path, val, attempts=4)
            (res["failed"] if err else res["applied"]).append(
                "%s=%s" % (path, val) if not err else err)

    nv = snap.get("nvidia") or {}
    # Будим nvidia-smi только если что-то реально меняли: каждый запрос
    # поднимает дискретку, а откат в большинстве случаев — возврат к
    # «и так уже было». pm менялся при включении лишь если он был Enabled.
    want_pl = bool(nv.get("_pl_changed"))
    want_pm = str(nv.get("persistence_mode") or "").lower().startswith("e")
    need_nv = want_pl or want_pm
    if not need_nv:
        res["skipped"].append("nvidia: лимиты не менялись — дискретку не будим")
    cur = _nvidia_limits() if need_nv else {}
    if want_pl and cur.get("power_limit") != nv["power_limit"]:
        rc, out = nvidia(["-pl", str(nv["power_limit"])])
        if rc == 0 and _nvidia_warn(out):
            res["skipped"].append("nvidia -pl: прошивка не поддерживает лимит")
        elif rc == 0:
            res["applied"].append("nvidia power_limit=%s" % nv["power_limit"])
        elif rc is not None:
            res["failed"].append("nvidia -pl: %s" % (out or "отказ"))
    if want_pm and \
            nv["persistence_mode"].lower() != (cur.get("persistence_mode") or "").lower():
        rc, out = nvidia(["-pm", "1"])
        if rc == 0:
            res["applied"].append("nvidia persistence=%s" % nv["persistence_mode"])
        elif rc is not None:
            res["failed"].append("nvidia -pm: %s" % (out or "отказ"))

    # --- радио: вернуть ровно то, что было в снимке -------------------------
    wif = snap.get("wifi") or {}
    iface = wif.get("iface") or (wifi_ifaces() or [None])[0]
    saved_ps = wif.get("power_save")
    if not iface:
        res["skipped"].append("wifi: нет интерфейса")
    elif saved_ps not in ("on", "off"):
        res["skipped"].append("wifi: в снимке не записано исходное состояние")
    else:
        err = wifi_set(iface, saved_ps == "on")
        res["applied" if err is None else "failed"].append(
            "wifi power_save=%s (%s)" % (saved_ps, iface) if err is None
            else "wifi: %s" % err)

    saved_bt = (snap.get("bt") or {}).get("soft")
    if saved_bt not in ("yes", "no"):
        res["skipped"].append("bluetooth: в снимке не записано исходное состояние")
    else:
        err = bt_set(saved_bt == "yes")
        res["applied" if err is None else "failed"].append(
            "bluetooth soft-block=%s" % saved_bt if err is None
            else "bluetooth: %s" % err)

    try:
        os.remove(STATE_FILE)
    except OSError:
        pass
    return res


def mux_set(mode: str) -> dict:
    """MUX: hybrid=0, discrete=1. Переключение подтверждается только
    после перезагрузки (прошивка), поэтому мы лишь выставляем бит."""
    val = {"hybrid": "0", "discrete": "1"}[mode]
    cur = read(MUX_PATH)
    if cur is None:
        return {"mode": "mux", "failed": ["нет %s" % MUX_PATH],
                "applied": [], "skipped": []}
    if cur == val:
        return {"mode": "mux", "applied": ["mux уже %s" % mode],
                "skipped": [], "failed": [], "reboot_required": False}
    err = write(MUX_PATH, val)
    if err:
        return {"mode": "mux", "failed": [err], "applied": [], "skipped": []}
    return {"mode": "mux", "applied": ["mux=%s (%s)" % (mode, val)],
            "skipped": [], "failed": [], "reboot_required": True}


def status(with_nvidia: bool = False) -> dict:
    """Снимок ручков.

    По умолчанию БЕЗ запросов nvidia-smi: каждый такой запрос поднимает
    дискретку из Runtime D3, и обычный опрос раз в 5 с (вкладка «Питание»)
    свёл бы на нет весь смысл усыпления. Флаг --nvidia — осознанное
    пробуждение, когда карта действительно нужна.
    """
    st = {"tool": TOOL, "euid": os.geteuid()}
    st["platform_profile"] = read(PLATFORM_PROFILE)
    st["platform_profile_choices"] = read(PLATFORM_PROFILE + "_choices")
    st["no_turbo"] = read(os.path.join(PSTATE_DIR, "no_turbo"))
    st["max_perf_pct"] = read(os.path.join(PSTATE_DIR, "max_perf_pct"))
    st["pstate_status"] = read(os.path.join(PSTATE_DIR, "status"))
    st["governor"] = read("/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor")
    st["epp"] = read(
        "/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference")
    st["rapl_pl1_w"] = _watts(read(os.path.join(RAPL, "constraint_0_power_limit_uw")))
    st["rapl_pl2_w"] = _watts(read(os.path.join(RAPL, "constraint_1_power_limit_uw")))
    st["max_freq_mhz"] = _mhz(read(
        "/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq"))
    st["dgpu_control"] = read(
        "/sys/bus/pci/devices/%s/power/control" % DGPU_PCI)
    runtime = dgpu_runtime()
    st["dgpu_runtime"] = runtime
    st["mux"] = read(MUX_PATH)
    iface = (wifi_ifaces() or [None])[0]
    st["wifi_iface"] = iface
    st["wifi_power_save"] = wifi_get(iface) if iface else None
    st["bt_soft"] = bt_soft()
    if with_nvidia and runtime != "suspended":
        nv = _nvidia_limits()
        st["nvidia_pl_w"] = _watts(nv.get("power_limit"))
        st["nvidia_persistence"] = nv.get("persistence_mode")
        rc, out = nvidia(["--query-gpu=temperature.gpu",
                          "--format=csv,noheader,nounits"])
        st["nvidia_temp"] = out.strip() if rc == 0 and out else None
        st["nvidia_quiet"] = False
    else:
        st["nvidia_pl_w"] = None
        st["nvidia_persistence"] = None
        st["nvidia_temp"] = None
        st["nvidia_quiet"] = True
    st["typewriter_saved"] = load_snapshot() is not None
    # --- каскад: цель, план и последний замер факта -----------------------
    cas = _cascade_read() or {}
    st["cascade_target"] = cas.get("target")
    st["cascade_cpu"] = cas.get("cpu")
    st["cascade_plan"] = cas.get("plan")
    st["cascade_measure"] = cas.get("measure")
    st["brightness_pct"] = brightness().get("pct")
    st["usb_autosuspend"] = read("/sys/module/usbcore/parameters/autosuspend")
    return st


def _watts(v):
    try:
        return round(float(v) / 1e6, 1) if v and float(v) > 1000 else float(v)
    except (TypeError, ValueError):
        return None


def _mhz(v):
    """scaling_max_freq отдаёт кГц — показываем МГц."""
    try:
        return int(round(float(v) / 1000.0))
    except (TypeError, ValueError):
        return None


def emit(res: dict, as_json: bool) -> int:
    if as_json:
        print(json.dumps(res, ensure_ascii=False))
    else:
        for key in ("applied", "skipped", "failed"):
            for line in res.get(key) or []:
                mark = {"applied": "+", "skipped": "-", "failed": "!"}[key]
                print(" %s %s" % (mark, line))
        if res.get("reboot_required"):
            print(" ! требуется перезагрузка")
        m = res.get("measure") or {}
        if m.get("w") is not None:
            mark = "OK" if m.get("feasible") else "!"
            print(" %s факт %.1f Вт из цели %s · CPU %s · плата %s · "
                  "минимум плана %.1f Вт" % (
                      mark, m["w"], m.get("target", "-"),
                      m.get("rapl_w", "-"), m.get("platform_w", "-"),
                      m.get("min_w") or 0.0))
        elif m:
            print(" - замер: %s" % (m.get("reason") or "нет данных"))
        print("%s: %s" % (res.get("mode", "ok"),
                          "ошибок=%d" % len(res.get("failed") or [])))
    return 1 if res.get("failed") else 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog=TOOL, add_help=True)
    # --json живёт и сверху, и в каждой подкоманде: иначе
    # `victus-power status --json` argparse отвергает (общий флаг после подкоманды)
    common = argparse.ArgumentParser(add_help=False)
    # SUPPRESS: иначе подкоманда своим default=False затирает флаг верхнего уровня
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="вывод JSON")
    ap.add_argument("--json", action="store_true", help="вывод JSON")
    sub = ap.add_subparsers(dest="cmd")

    p_status = sub.add_parser("status", parents=[common])
    p_status.add_argument("--nvidia", action="store_true",
                          help="опросить nvidia-smi (будит дискретку)")
    sub.add_parser("restore", parents=[common])
    sub.add_parser("snapshot", parents=[common])
    p_apply = sub.add_parser("apply", parents=[common])
    p_apply.add_argument("mode", choices=["typewriter"])
    p_mux = sub.add_parser("mux", parents=[common])
    p_mux.add_argument("mode", choices=["hybrid", "discrete"])
    p_watts = sub.add_parser("watts", parents=[common])
    p_watts.add_argument("watt", type=int, help="потолок мощности CPU 3..25 Вт")
    p_draw = sub.add_parser("draw", parents=[common])
    p_draw.add_argument("--dur", type=float, default=1.2,
                        help="интервал измерения, с (0.3..5)")
    p_meas = sub.add_parser("measure", parents=[common])
    p_meas.add_argument("--dur", type=float, default=40.0,
                        help="окно замера, с (3..60)")
    p_cas = sub.add_parser("cascade", parents=[common])
    p_cas.add_argument("target", type=int, help="цель по всей системе 5..25 Вт")
    p_cas.add_argument("--cpu", type=int, default=None,
                       help="ручной потолок CPU 3..25 Вт")
    p_cas.add_argument("--dur", type=float, default=30.0,
                       help="окно замера факта, с (3..60)")
    p_cas.add_argument("--no-stabilize", action="store_true",
                       help="не замерять и не подтягивать план к цели")
    sub.add_parser("cascade-off", parents=[common])
    p_br = sub.add_parser("brightness", parents=[common])
    p_br.add_argument("pct", type=int, nargs="?", default=None,
                      help="яркость в процентах (без аргумента — прочитать)")

    a = ap.parse_args(argv)

    if os.geteuid() != 0:
        print("%s: нужен root (sudo)" % TOOL, file=sys.stderr)
        return 2

    if a.cmd == "status":
        st = status(with_nvidia=bool(getattr(a, "nvidia", False)))
        if a.json:
            print(json.dumps(st, ensure_ascii=False))
        else:
            for k, v in st.items():
                print("%-24s %s" % (k, v))
        return 0
    if a.cmd == "restore":
        return emit(restore(), a.json)
    if a.cmd == "snapshot":
        return emit(snapshot_now(), a.json)
    if a.cmd == "mux":
        return emit(mux_set(a.mode), a.json)
    if a.cmd == "apply":
        return emit(apply_typewriter(), a.json)
    if a.cmd == "watts":
        return emit(set_watts(a.watt), a.json)
    if a.cmd == "cascade":
        return emit(cascade_apply(a.target, a.cpu,
                                  stabilize=not a.no_stabilize, dur=a.dur),
                    a.json)
    if a.cmd == "measure":
        res = measure_total(a.dur)
        if a.json:
            print(json.dumps(res, ensure_ascii=False))
        elif res.get("ok"):
            print("факт %.2f Вт (окно %.0f с, %s) · power_now %.2f Вт"
                  % (res["w"], res.get("dur", 0), res.get("status", "-"),
                     res.get("pnow_avg") or res.get("pnow0") or 0.0))
        else:
            print("! замер невозможен: %s" % res.get("reason"))
        return 0 if res.get("ok") else 1
    if a.cmd == "cascade-off":
        return emit(cascade_off(), a.json)
    if a.cmd == "brightness":
        res = brightness(a.pct)
        if a.json:
            print(json.dumps(res, ensure_ascii=False))
        elif res.get("pct") is not None:
            print("яркость %d%%" % res["pct"])
        return 1 if res.get("failed") else 0
    if a.cmd == "draw":
        res = draw(a.dur)
        if a.json:
            print(json.dumps(res, ensure_ascii=False))
        elif res.get("failed"):
            print("! %s" % res["failed"][0])
        else:
            print("cpu %.2f Вт · PL1 %s Вт · частота до %s МГц (%.2f с)" % (
                res.get("cpu_w", 0), res.get("pl1_w"),
                res.get("max_freq_mhz"), res.get("dur", 0)))
        return 1 if res.get("failed") else 0

    ap.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
