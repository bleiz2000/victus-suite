#!/usr/bin/env python3
"""victus-power — root-хелпер режимов питания victus-suite.

Один узкий вход в права: sudoers даёт NOPASSWD только на этот файл, поэтому
команды жёстко белый-листятся (никакого shell, никаких произвольных путей).

Команды:
    victus-power status [--json]     прочитать все ручки (read-only)
    victus-power apply typewriter    режим «Печатная машинка» (сохраняя прошлое)
    victus-power restore             вернуть снимок, сделанный перед apply
    victus-power mux <hybrid|discrete>  явное переключение MUX (нужен reboot)

Снимок прошлого состояния: /var/lib/victus-suite/power-state.json
Всё, что не поддерживается прошивкой/драйвером, пропускается с пометкой —
режим обязан работать на машине без единой ошибки «файл не найден».
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import subprocess
import sys
import time

TOOL = "victus-power"
STATE_DIR = "/var/lib/victus-suite"
STATE_FILE = os.path.join(STATE_DIR, "power-state.json")

PLATFORM_PROFILE = "/sys/firmware/acpi/platform_profile"
PSTATE_DIR = "/sys/devices/system/cpu/intel_pstate"
RAPL = "/sys/class/powercap/intel-rapl:0"
DGPU_PCI = "0000:01:00.0"
HPWMI = "/sys/devices/platform/hp-wmi"
MUX_PATH = os.path.join(HPWMI, "gpu_mux_mode")

# «Печатная машинка»: значение каждого ручка. Отсутствующие пути = skip.
TYPEWRITER = {
    "platform_profile": ("path", PLATFORM_PROFILE, "low-power"),
    "no_turbo": ("path", os.path.join(PSTATE_DIR, "no_turbo"), "1"),
    "max_perf_pct": ("path", os.path.join(PSTATE_DIR, "max_perf_pct"), "40"),
    "rapl_pl1": ("path", os.path.join(RAPL, "constraint_0_power_limit_uw"),
                 "15000000"),
    "rapl_pl2": ("path", os.path.join(RAPL, "constraint_1_power_limit_uw"),
                 "30000000"),
    "dgpu_runtime": ("path", "/sys/bus/pci/devices/%s/power/control" % DGPU_PCI,
                     "auto"),
    # hybrid = iGPU рисует десктоп, dGPU только по запросу — максимум экономии
    "mux": ("path", MUX_PATH, "0"),
}
# ручки, которые повторяются на каждое ядро CPU
PER_CPU = (
    ("governor", "/sys/devices/system/cpu/cpu%d/cpufreq/scaling_governor",
     "powersave"),
    ("epp", "/sys/devices/system/cpu/cpu%d/cpufreq/energy_performance_preference",
     "power"),
    # Жёсткий потолок частоты: «печатной машинке» 4.7 ГГц не нужны.
    # Пишем ПОСЛЕ governor/EPP (иначе intel_pstate может перетереть), в снимок
    # идёт своё значение каждого ядра — P- и E-ядра тут разные.
    ("scaling_max_freq",
     "/sys/devices/system/cpu/cpu%d/cpufreq/scaling_max_freq",
     "1800000"),
)
# минимальный PL2, ниже которого BIOS уже не опускается
NVIDIA_PL_MIN_W = 20

# внешние утилиты: только фиксированные argv, без shell
IW = "/usr/bin/iw"
RFKILL = "/usr/bin/rfkill"


def read(path: str):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return None


def write(path: str, value: str, attempts: int = 1, delay: float = 0.2):
    """Возвращает None при успехе, текст ошибки — при провале.

    intel_pstate «проглатывает» запись scaling_max_freq сразу после смены
    no_turbo/max_perf_pct: значение просто не меняется, но через доли секунды
    начинает приниматься (замер: до 2 попыток, 0.25 с). Без ретрая это был бы
    честный, но ложный отказ «все ядра отказали». Для обычных ручков
    attempts=1 — там мгновенный отказ означает реальную проблему.
    """
    if not os.path.exists(path):
        return "нет файла %s" % path
    last = None
    for attempt in range(max(1, int(attempts))):
        try:
            with open(path, "w") as fh:
                fh.write(value + "\n")
        except OSError as exc:
            last = "%s: %s" % (path, exc.strerror or exc)
        else:
            got = read(path)
            if got is None or got == value:
                return None
            last = "%s: прошивка отклонила %s (осталось %s)" % (path, value, got)
        if attempt + 1 < attempts:
            time.sleep(delay)
    return last


def cpu_ids() -> list[int]:
    ids = []
    for p in sorted(glob.glob("/sys/devices/system/cpu/cpu[0-9]*")):
        tail = os.path.basename(p)[3:]
        if tail.isdigit():
            ids.append(int(tail))
    return ids


def _cap_freq(cpu: int, want: str) -> str:
    """Не выше того, что ядро разрешает прямо сейчас.

    intel_pstate режет cpuinfo_max_freq по no_turbo/max_perf_pct; запись
    выше порога отклоняется целиком (не «обрезается»), и мы бы получили
    ложный отказ «все ядра отказали»."""
    info = read("/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq" % cpu)
    try:
        return str(min(int(want), int(info)))
    except (TypeError, ValueError):
        return want


def nvidia(args: list[str], timeout: float = 8.0):
    """Запуск nvidia-smi без shell; (rc, stdout) либо (None, причина)."""
    import shutil
    if not shutil.which("nvidia-smi"):
        return None, "nvidia-smi отсутствует"
    try:
        r = subprocess.run(["nvidia-smi"] + args, capture_output=True,
                           text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as exc:
        return None, str(exc)
    return r.returncode, (r.stdout or r.stderr or "").strip()


def _nvidia_limits() -> dict:
    """power.limit на выключенной дискретке отдаёт N/A — не верим вслепую."""
    rc, out = nvidia(["--query-gpu=power.limit,power.max_limit,persistence_mode",
                      "--format=csv,noheader,nounits"])
    res = {}
    if rc != 0 or not out:
        return res
    parts = [p.strip() for p in out.split(",")]
    for key, raw in (("power_limit", parts[0] if parts else None),
                     ("max_limit", parts[1] if len(parts) > 1 else None),
                     ("persistence_mode", parts[2] if len(parts) > 2 else None)):
        if raw is None:
            continue
        if key.endswith("limit"):
            try:
                res[key] = "%.1f" % float(raw.split()[0])
            except (ValueError, IndexError):
                pass
        elif raw and raw.lower() != "n/a":
            res[key] = raw
    # откатываемся на предел, если текущий неизвестен
    if "power_limit" not in res and "max_limit" in res:
        res["power_limit"] = res["max_limit"]
    return res


# ------------------------------------------------------ беспроводные модули
def _run(argv, timeout=6.0):
    """(rc, text) по фиксированному argv. Никакого shell, никаких аргументов
    извне — белый-лист вызовов, как и весь этот бинарник."""
    if not os.path.exists(argv[0]):
        return None, "нет %s" % argv[0]
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as exc:
        return None, str(exc)
    return r.returncode, (r.stdout or r.stderr or "").strip()


def wifi_ifaces() -> list:
    """Интерфейсы с /sys/class/net/<iface>/wireless (wlan0, wlo1, …)."""
    out = []
    for p in glob.glob("/sys/class/net/*/wireless"):
        parts = p.split(os.sep)
        if len(parts) >= 3:
            out.append(parts[-2])
    return sorted(set(out))


def wifi_get(iface: str):
    """'on'/'off' либо None (iw не отвечает / нет интерфейса)."""
    rc, out = _run([IW, "dev", iface, "get", "power_save"])
    if rc != 0:
        return None
    for line in (out or "").splitlines():
        tail = line.rsplit(":", 1)[-1].strip().lower()
        if tail in ("on", "off"):
            return tail
    return None


def wifi_set(iface: str, on: bool) -> str | None:
    want = "on" if on else "off"
    rc, out = _run([IW, "dev", iface, "set", "power_save", want])
    if rc != 0:
        return "iw: %s" % (out or "rc=%s" % rc)
    got = wifi_get(iface)
    if got is not None and got != want:
        return "iw применил не сразу (сейчас %s)" % got
    return None


def bt_soft():
    """'yes'/'no' (soft-block) либо None, если bluetooth-устройства нет."""
    rc, out = _run([RFKILL, "list", "bluetooth"])
    if rc != 0:
        return None
    for line in (out or "").splitlines():
        if "soft blocked" in line.lower():
            tail = line.rsplit(":", 1)[-1].strip().lower()
            if tail in ("yes", "no"):
                return tail
    return None


def bt_set(block: bool) -> str | None:
    rc, out = _run([RFKILL, "block" if block else "unblock", "bluetooth"])
    if rc != 0:
        return "rfkill: %s" % (out or "rc=%s" % rc)
    got = bt_soft()
    if got is not None and got != ("yes" if block else "no"):
        return "rfkill не подтвердил состояние (сейчас %s)" % got
    return None


def dgpu_runtime(wait: float = 0.0):
    """runtime_status дискретки: 'suspended' = она уже в Runtime D3."""
    path = "/sys/bus/pci/devices/%s/power/runtime_status" % DGPU_PCI
    if not wait:
        return read(path)
    end = time.monotonic() + wait
    while True:
        val = read(path)
        if val == "suspended" or time.monotonic() >= end:
            return val
        time.sleep(0.3)


# ------------------------------------------------------------------ snapshot
def snapshot() -> dict:
    """Текущее состояние всех ручков — для корректного отката."""
    snap = {"ts": time.time(), "knobs": {}, "per_cpu": {}, "nvidia": {}}
    for name, (_kind, path, _val) in TYPEWRITER.items():
        snap["knobs"][name] = read(path)
    for name, tmpl, _val in PER_CPU:
        snap["per_cpu"][name] = {
            "template": tmpl,
            "values": {str(i): read(tmpl % i) for i in cpu_ids()},
        }
    # Не будим спящую дискретку только ради того, чтобы записать её лимит:
    # усыпленная карта — результат, который мы и так добиваемся. Если она
    # уже проснулась — снимаем лимит, тогда apply сможет его снизить.
    if dgpu_runtime() == "suspended":
        snap["nvidia"] = {"_asleep": True}
    else:
        snap["nvidia"] = _nvidia_limits()
    # радио: что было ДО режима, чтобы restore вернул ровно это
    iface = (wifi_ifaces() or [None])[0]
    snap["wifi"] = {"iface": iface,
                    "power_save": wifi_get(iface) if iface else None}
    snap["bt"] = {"soft": bt_soft()}
    snap["dgpu_runtime"] = dgpu_runtime()
    return snap


def _write_snapshot(snap: dict) -> bool:
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(STATE_FILE, "w", encoding="utf-8") as fh:
            json.dump(snap, fh, ensure_ascii=False, indent=2)
        os.chmod(STATE_FILE, 0o600)
        return True
    except OSError as exc:
        print("%s: не смог сохранить снимок: %s" % (TOOL, exc), file=sys.stderr)
        return False


def save_snapshot() -> dict:
    snap = snapshot()
    _write_snapshot(snap)
    return snap


def looks_typewriter(knobs: dict) -> bool:
    """Похоже ли состояние на уже включённую «печатную машинку».

    Симптомы: выключен turbo, задавлен RAPL, прижат max_perf_pct или
    выбран тихий платформенный профиль. Один из них — достаточное
    подозрение, что мы смотрим НЕ baseline.
    """
    try:
        if str(knobs.get("no_turbo") or "") == "1":
            return True
        pl1 = int(float(str(knobs.get("rapl_pl1") or "0").split()[0]))
        if pl1 and pl1 <= 20000000:
            return True
        if int(float(str(knobs.get("max_perf_pct") or "100").split()[0])) <= 50:
            return True
    except (ValueError, TypeError):
        pass
    return str(knobs.get("platform_profile") or "") == "low-power"


def snapshot_now() -> dict:
    """Явно зафиксировать текущее состояние как точку отката.

    Нужен ОТДЕЛЬНОЙ командой: power-profiles-daemon меняет platform_profile и
    EPP сам, поэтому снимок обязан быть сделан ДО первого изменения, а не в
    момент apply (иначе в точку отката попадает уже «печатная машинка»).

    Две ловушки, которые иначе убивают откат:
      * существующий снимок перетирается текущим (часто уже изменённым)
        состоянием — restore начинает «возвращать» печатную машинку;
      * снимок снят с уже изменённой системы (ручной apply, падение TUI).
    Поэтому команда идемпотентна и отказывается работать с изменённой системой.
    """
    have = load_snapshot()
    if have is not None:
        return {"mode": "snapshot", "applied": [],
                "skipped": ["точка отката уже есть — не перетираю"],
                "failed": [], "knobs": have.get("knobs")}
    knobs = {name: read(path) for name, (_kind, path, _val) in TYPEWRITER.items()}
    if looks_typewriter(knobs):
        return {"mode": "snapshot", "applied": [], "skipped": [],
                "failed": ["система уже в режиме печатной машинки "
                           "(%s) — baseline не записан"
                           % ", ".join("%s=%s" % (k, v) for k, v in knobs.items()
                                       if v is not None and
                                       k in ("no_turbo", "rapl_pl1",
                                             "platform_profile"))],
                "knobs": knobs}
    snap = save_snapshot()
    return {"mode": "snapshot", "applied": ["точка отката сохранена"],
            "skipped": [], "failed": [], "knobs": snap.get("knobs")}


def load_snapshot():
    try:
        with open(STATE_FILE, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


# -------------------------------------------------------------------- actions
def apply_typewriter() -> dict:
    res = {"mode": "typewriter", "applied": [], "skipped": [],
           "failed": [], "restorable": True}
    targets = []                # (имя, путь, значение) — проверим после записи

    # Точка отката — состояние ДО первого включения. Повторный apply не должен
    # её затирать, иначе restore вернёт уже изменённые значения (low-power и т.п.)
    if load_snapshot() is None:
        snap = save_snapshot()
    else:
        snap = load_snapshot()

    for name, (_kind, path, value) in TYPEWRITER.items():
        cur = read(path)
        if cur is None:
            res["skipped"].append("%s: нет %s" % (name, path))
            continue
        if cur == value:
            res["applied"].append("%s=%s (уже так)" % (name, value))
            continue
        err = write(path, value)
        if err:
            res["failed"].append("%s: %s" % (name, err))
        else:
            res["applied"].append("%s=%s" % (name, value))
            targets.append((name, path, value))

    for name, tmpl, value in PER_CPU:
        ids = cpu_ids()
        if not ids:
            res["skipped"].append("%s: нет cpu*/cpufreq" % name)
            continue
        ok = bad = 0
        first_err = ""
        written = set()
        for i in ids:
            path = tmpl % i
            want = value
            if name == "scaling_max_freq":
                want = _cap_freq(i, value)
            if read(path) is None:
                continue
            # частотным ручкам нужен ретрай (см. write): intel_pstate
            # иногда не берёт запись сразу после no_turbo/max_perf_pct
            err = write(path, want, attempts=4)
            if err:
                bad += 1
                first_err = first_err or err
            else:
                ok += 1
                written.add(want)
                targets.append(("%s[cpu%d]" % (name, i), path, want))
        if ok:
            # ядра могут упираться в разные cpuinfo_max_freq — показываем
            # фактически выставленное, а не задуманное
            shown = written.pop() if len(written) == 1 else                 "%s..%s" % (min(written), max(written))
            res["applied"].append("%s=%s (%d cpu)" % (name, shown, ok))
        if bad:
            res["failed"].append("%s: %d ядер отказали%s"
                                 % (name, bad, " — %s" % first_err[:90]
                                    if first_err else ""))
        if not ok and not bad:
            res["skipped"].append("%s: нет %s" % (name, tmpl % 0))

    # NVIDIA: persistence off + потолок мощности (дискретка уходит в сон,
    # а если проснётся — ей разрешено только %d Вт).
    # Команды пропускаются, когда результат был бы тождественным: каждый
    # вызов nvidia-smi будит дискретку, ради которой мы всё и делаем.
    saved = (snap.get("nvidia") or {})
    if saved.get("_asleep"):
        res["skipped"].append(
            "nvidia: дискретка была в Runtime D3 — persistence/лимит не трогали")
    elif str(saved.get("persistence_mode") or "").strip().lower() in ("0", "off",
                                                                      "disabled"):
        res["applied"].append("nvidia persistence=0 (уже так)")
    else:
        rc, out = nvidia(["-pm", "0"])
        if rc is None:
            res["skipped"].append("nvidia: нет nvidia-smi")
        elif rc != 0 or _nvidia_warn(out):
            res["failed"].append("nvidia: не смог выключить persistence mode (%s)"
                                 % (out or "rc=%s" % rc).strip()[:80])
        else:
            res["applied"].append("nvidia persistence=0")
    try:
        cur_pl = float((saved.get("power_limit") or "0").split()[0])
    except (ValueError, AttributeError, IndexError):
        cur_pl = 0.0
    target = min(cur_pl, NVIDIA_PL_MIN_W) or NVIDIA_PL_MIN_W
    if saved.get("_asleep") or not cur_pl:
        pass                                # уже пропущено/нет данных
    elif cur_pl <= NVIDIA_PL_MIN_W:
        # снимок говорит, что лимит и так не выше потолка — трогать нечего
        res["applied"].append("nvidia power_limit=%.0fW (уже так)" % cur_pl)
    else:
        rc, out = nvidia(["-pl", "%.1f" % target])
        if rc is None:
            pass
        elif rc != 0 or _nvidia_warn(out):
            # драйвер отвечает rc=0 и текстом «not supported» — это не успех
            res["skipped"].append("nvidia -pl: %s"
                                  % ((out or "отказ").strip().splitlines()[:1])[0][:90])
        else:
            res["applied"].append("nvidia power_limit=%.0fW" % target)
            # restore обязан вернуть лимит, даже если к тому моменту дискретка
            # уже уснула — иначе пропустим восстановление «по спящей»
            snap.setdefault("nvidia", {})["_pl_changed"] = True
            _write_snapshot(snap)

    # --- беспроводные модули: wifi power-save + bluetooth rfkill -----------
    iface = (wifi_ifaces() or [None])[0]
    if not iface:
        res["skipped"].append("wifi: нет беспроводного интерфейса")
    else:
        err = wifi_set(iface, True)
        res["applied" if err is None else "failed"].append(
            "wifi power_save=on (%s)" % iface if err is None
            else "wifi: %s" % err)
    if bt_soft() is None:
        res["skipped"].append("bluetooth: устройства rfkill не найдено")
    else:
        err = bt_set(True)
        res["applied" if err is None else "failed"].append(
            "bluetooth soft-block (rfkill)" if err is None
            else "bluetooth: %s" % err)

    # EC имеет право перетереть наши записи (platform_profile, например,
    # возвращает RAPL к своим 55 Вт) — перечитываем и честно рапортуем.
    if targets:
        time.sleep(1.0)
        for name, path, value in targets:
            got = read(path)
            if got != value:
                res["applied"] = [a for a in res["applied"]
                                  if not a.startswith(name.split("[")[0] + "=")]
                res["failed"].append("%s: прошивка откатила %s (вернулось %s)"
                                     % (name, value, got))

    # --- дискретка: дождаться Runtime D3 --------------------------------------
    # nvidia-smi поднимает карту на 5–15 с, поэтому ждём недолго: даже если
    # не успели, держатели (Hyprland, voxtype) НЕ мешают усыпанию — карта
    # уходит в Runtime D3 сама после idle-таймаута, и вкладка показывает это.
    runtime = dgpu_runtime(wait=4.0)
    if runtime == "suspended":
        res["applied"].append("dGPU runtime=suspended (Runtime D3)")
    elif runtime is None:
        res["skipped"].append("dGPU: нет sysfs питания на %s" % DGPU_PCI)
    else:
        res["skipped"].append(
            "dGPU ещё %s — уйдёт в Runtime D3 сама после idle" % runtime)

    res["snapshot"] = bool(snap)
    res["dgpu_runtime"] = runtime
    return res


def _nvidia_warn(out) -> bool:
    """nvidia-smi возвращает rc=0 даже когда ничего не сделал."""
    text = (out or "").lower()
    return any(s in text for s in ("not supported", "not supported for",
                                   "[n/a]", "invalid", "failed"))


def restore() -> dict:
    snap = load_snapshot()
    if not snap:
        return {"mode": "restore", "applied": [], "skipped": [],
                "failed": ["снимок %s не найден — откатывать нечего"
                           % STATE_FILE]}
    res = {"mode": "restore", "applied": [], "skipped": [], "failed": []}

    # ПОРЯДОК ОБРАТНЫЙ К apply и это важно: сначала «глобальные» ручки
    # (no_turbo, max_perf_pct, platform_profile) — они возвращают ядрам
    # полный диапазон частот, иначе intel_pstate не примет запись
    # scaling_max_freq из снимка и откат был бы неполным.
    saved_knobs = snap.get("knobs") or {}
    for name, (_kind, path, _val) in TYPEWRITER.items():
        val = saved_knobs.get(name)
        if val is None:
            res["skipped"].append("%s: в снимке пусто" % name)
            continue
        if read(path) is None:
            res["skipped"].append("%s: нет %s" % (name, path))
            continue
        if read(path) == val:
            continue                # MUX, например, отдаёт EINVAL на тот же бит
        err = write(path, val)
        (res["failed"] if err else res["applied"]).append(
            "%s=%s" % (name, val) if not err else err)

    for name, data in (snap.get("per_cpu") or {}).items():
        tmpl = data.get("template")
        for idx, val in (data.get("values") or {}).items():
            if not tmpl or val is None:
                continue
            path = tmpl % int(idx)
            if read(path) is None:
                res["skipped"].append(path)
                continue
            if read(path) == val:
                continue            # уже в прошлом состоянии — не дёргаем прошивку
            # тот же ретрай, что при включении: частоты не всегда
            # берутся с первого раза
            err = write(path, val, attempts=4)
            (res["failed"] if err else res["applied"]).append(
                "%s=%s" % (path, val) if not err else err)

    nv = snap.get("nvidia") or {}
    # Будим nvidia-smi только если что-то реально меняли: каждый запрос
    # поднимает дискретку, а откат в большинстве случаев — возврат к
    # «и так уже было». pm менялся при включении лишь если он был Enabled.
    want_pl = bool(nv.get("_pl_changed"))
    want_pm = str(nv.get("persistence_mode") or "").lower().startswith("e")
    need_nv = want_pl or want_pm
    if not need_nv:
        res["skipped"].append("nvidia: лимиты не менялись — дискретку не будим")
    cur = _nvidia_limits() if need_nv else {}
    if want_pl and cur.get("power_limit") != nv["power_limit"]:
        rc, out = nvidia(["-pl", str(nv["power_limit"])])
        if rc == 0 and _nvidia_warn(out):
            res["skipped"].append("nvidia -pl: прошивка не поддерживает лимит")
        elif rc == 0:
            res["applied"].append("nvidia power_limit=%s" % nv["power_limit"])
        elif rc is not None:
            res["failed"].append("nvidia -pl: %s" % (out or "отказ"))
    if want_pm and \
            nv["persistence_mode"].lower() != (cur.get("persistence_mode") or "").lower():
        rc, out = nvidia(["-pm", "1"])
        if rc == 0:
            res["applied"].append("nvidia persistence=%s" % nv["persistence_mode"])
        elif rc is not None:
            res["failed"].append("nvidia -pm: %s" % (out or "отказ"))

    # --- радио: вернуть ровно то, что было в снимке -------------------------
    wif = snap.get("wifi") or {}
    iface = wif.get("iface") or (wifi_ifaces() or [None])[0]
    saved_ps = wif.get("power_save")
    if not iface:
        res["skipped"].append("wifi: нет интерфейса")
    elif saved_ps not in ("on", "off"):
        res["skipped"].append("wifi: в снимке не записано исходное состояние")
    else:
        err = wifi_set(iface, saved_ps == "on")
        res["applied" if err is None else "failed"].append(
            "wifi power_save=%s (%s)" % (saved_ps, iface) if err is None
            else "wifi: %s" % err)

    saved_bt = (snap.get("bt") or {}).get("soft")
    if saved_bt not in ("yes", "no"):
        res["skipped"].append("bluetooth: в снимке не записано исходное состояние")
    else:
        err = bt_set(saved_bt == "yes")
        res["applied" if err is None else "failed"].append(
            "bluetooth soft-block=%s" % saved_bt if err is None
            else "bluetooth: %s" % err)

    try:
        os.remove(STATE_FILE)
    except OSError:
        pass
    return res


def mux_set(mode: str) -> dict:
    """MUX: hybrid=0, discrete=1. Переключение подтверждается только
    после перезагрузки (прошивка), поэтому мы лишь выставляем бит."""
    val = {"hybrid": "0", "discrete": "1"}[mode]
    cur = read(MUX_PATH)
    if cur is None:
        return {"mode": "mux", "failed": ["нет %s" % MUX_PATH],
                "applied": [], "skipped": []}
    if cur == val:
        return {"mode": "mux", "applied": ["mux уже %s" % mode],
                "skipped": [], "failed": [], "reboot_required": False}
    err = write(MUX_PATH, val)
    if err:
        return {"mode": "mux", "failed": [err], "applied": [], "skipped": []}
    return {"mode": "mux", "applied": ["mux=%s (%s)" % (mode, val)],
            "skipped": [], "failed": [], "reboot_required": True}


def status(with_nvidia: bool = False) -> dict:
    """Снимок ручков.

    По умолчанию БЕЗ запросов nvidia-smi: каждый такой запрос поднимает
    дискретку из Runtime D3, и обычный опрос раз в 5 с (вкладка «Питание»)
    свёл бы на нет весь смысл усыпления. Флаг --nvidia — осознанное
    пробуждение, когда карта действительно нужна.
    """
    st = {"tool": TOOL, "euid": os.geteuid()}
    st["platform_profile"] = read(PLATFORM_PROFILE)
    st["platform_profile_choices"] = read(PLATFORM_PROFILE + "_choices")
    st["no_turbo"] = read(os.path.join(PSTATE_DIR, "no_turbo"))
    st["max_perf_pct"] = read(os.path.join(PSTATE_DIR, "max_perf_pct"))
    st["pstate_status"] = read(os.path.join(PSTATE_DIR, "status"))
    st["governor"] = read("/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor")
    st["epp"] = read(
        "/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference")
    st["rapl_pl1_w"] = _watts(read(os.path.join(RAPL, "constraint_0_power_limit_uw")))
    st["rapl_pl2_w"] = _watts(read(os.path.join(RAPL, "constraint_1_power_limit_uw")))
    st["max_freq_mhz"] = _mhz(read(
        "/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq"))
    st["dgpu_control"] = read(
        "/sys/bus/pci/devices/%s/power/control" % DGPU_PCI)
    runtime = dgpu_runtime()
    st["dgpu_runtime"] = runtime
    st["mux"] = read(MUX_PATH)
    iface = (wifi_ifaces() or [None])[0]
    st["wifi_iface"] = iface
    st["wifi_power_save"] = wifi_get(iface) if iface else None
    st["bt_soft"] = bt_soft()
    if with_nvidia and runtime != "suspended":
        nv = _nvidia_limits()
        st["nvidia_pl_w"] = _watts(nv.get("power_limit"))
        st["nvidia_persistence"] = nv.get("persistence_mode")
        rc, out = nvidia(["--query-gpu=temperature.gpu",
                          "--format=csv,noheader,nounits"])
        st["nvidia_temp"] = out.strip() if rc == 0 and out else None
        st["nvidia_quiet"] = False
    else:
        st["nvidia_pl_w"] = None
        st["nvidia_persistence"] = None
        st["nvidia_temp"] = None
        st["nvidia_quiet"] = True
    st["typewriter_saved"] = load_snapshot() is not None
    return st


def _watts(v):
    try:
        return round(float(v) / 1e6, 1) if v and float(v) > 1000 else float(v)
    except (TypeError, ValueError):
        return None


def _mhz(v):
    """scaling_max_freq отдаёт кГц — показываем МГц."""
    try:
        return int(round(float(v) / 1000.0))
    except (TypeError, ValueError):
        return None


def emit(res: dict, as_json: bool) -> int:
    if as_json:
        print(json.dumps(res, ensure_ascii=False))
    else:
        for key in ("applied", "skipped", "failed"):
            for line in res.get(key) or []:
                mark = {"applied": "+", "skipped": "-", "failed": "!"}[key]
                print(" %s %s" % (mark, line))
        if res.get("reboot_required"):
            print(" ! требуется перезагрузка")
        print("%s: %s" % (res.get("mode", "ok"),
                          "ошибок=%d" % len(res.get("failed") or [])))
    return 1 if res.get("failed") else 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog=TOOL, add_help=True)
    # --json живёт и сверху, и в каждой подкоманде: иначе
    # `victus-power status --json` argparse отвергает (общий флаг после подкоманды)
    common = argparse.ArgumentParser(add_help=False)
    # SUPPRESS: иначе подкоманда своим default=False затирает флаг верхнего уровня
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="вывод JSON")
    ap.add_argument("--json", action="store_true", help="вывод JSON")
    sub = ap.add_subparsers(dest="cmd")

    p_status = sub.add_parser("status", parents=[common])
    p_status.add_argument("--nvidia", action="store_true",
                          help="опросить nvidia-smi (будит дискретку)")
    sub.add_parser("restore", parents=[common])
    sub.add_parser("snapshot", parents=[common])
    p_apply = sub.add_parser("apply", parents=[common])
    p_apply.add_argument("mode", choices=["typewriter"])
    p_mux = sub.add_parser("mux", parents=[common])
    p_mux.add_argument("mode", choices=["hybrid", "discrete"])

    a = ap.parse_args(argv)

    if os.geteuid() != 0:
        print("%s: нужен root (sudo)" % TOOL, file=sys.stderr)
        return 2

    if a.cmd == "status":
        st = status(with_nvidia=bool(getattr(a, "nvidia", False)))
        if a.json:
            print(json.dumps(st, ensure_ascii=False))
        else:
            for k, v in st.items():
                print("%-24s %s" % (k, v))
        return 0
    if a.cmd == "restore":
        return emit(restore(), a.json)
    if a.cmd == "snapshot":
        return emit(snapshot_now(), a.json)
    if a.cmd == "mux":
        return emit(mux_set(a.mode), a.json)
    if a.cmd == "apply":
        return emit(apply_typewriter(), a.json)

    ap.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
