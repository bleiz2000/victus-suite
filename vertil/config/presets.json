{
  "schema": 1,
  "name": "victus-2026-09-30",
  "created": "2026-09-30",
  "updated": "2026-09-30",
  "description": "Пресет вентиляторов HP Victus 16-r0xxx: предиктивный контроллер SMART, снятый и проверён в 3-фазном тесте (BIOS AUTO / топор / SMART). Всё живёт только внутри vertil/, в систему ничего не пишется.",

  "device": {
    "board": "8BBE",
    "bios": "F.26",
    "kernel": "7.2.5-3-omarchy",
    "cpu": "Intel Core i5-13500H (4P+8E / 16 потоков)",
    "gpu": "NVIDIA RTX 4060 Laptop (sm_89)",
    "max_cpu_rpm": 5800,
    "max_gpu_rpm": 5800
  },

  "sensors": {
    "fan_chip": "hp",
    "fan_chip_driver": "hp-wmi",
    "cpu_chip": "coretemp",
    "cpu_input": "temp1_input",
    "vrm_proxy_zone": "thermal_zone4",
    "vrm_proxy_name": "TCPU_PCI",
    "board_proxy": "acpitz",
    "gpu_tool": "nvidia-smi",
    "note": "Датчика VRM нет — hp-wmi не экспортирует шину EC; используется ACPI-прокси TCPU_PCI. Искать чипы по name, НЕ по индексу hwmon (плавает)."
  },

  "fans": {
    "pwm_max": 255,
    "cpu": { "rpm_in": "fan1_input", "pwm_out": "pwm1" },
    "gpu": { "rpm_in": "fan2_input", "pwm_out": "pwm2" },
    "enable_attr": "pwm1_enable",
    "enable_is_shared": true,
    "modes": { "max": 0, "manual": 1, "auto": 2 },
    "readback_semantics": "pwm* на чтение = отображённый фактический RPM (не setpoint)",
    "write_rule": "запись в pwm* только при enable==1, иначе -EINVAL; запись только root"
  },

  "safety": {
    "fail_safe_pwm": 255,
    "fail_safe_enable_mode": 0,
    "hold_pwm_on_controller_loss": 180,
    "auto_transition_zero_rpm_seconds": 215,
    "auto_is_not_instant_fail_safe": true,
    "note": "Запись pwm1_enable=2 (MANUAL->AUTO) глушит вентиляторы на ~215 с при 92-99 C. Fail-safe = enable=0 (MAX) или удерживаемый PWM."
  },

  "guard": {
    "cpu_hot_c": 99,
    "cpu_hot_streak": 3,
    "cpu_hot_window_s": 3,
    "gpu_hot_c": 88,
    "hold_pwm": 180,
    "poll_s": 3,
    "log": "vertil/tools/lab/guard.log",
    "rationale": "96-100 C под нагрузкой на этой машине штатное состояние; порог поднят, чтобы guard не перебивал контроллер."
  },

  "smart": {
    "enabled": true,
    "horizon_s": 8.0,
    "slope_window_cpu_s": 6.0,
    "slope_window_vrm_s": 15.0,
    "history_s": 30.0,
    "floor_pwm": 60,
    "ceil_pwm": 255,
    "rise_pwm_per_s": 8.0,
    "fall_pwm_per_s": 3.0,
    "deadband": 2.0,
    "init_pwm": [79, 92],
    "cpu_band": { "low": 52.0, "span": 38.0, "weight": 1.0 },
    "gpu_band": { "low": 50.0, "span": 36.0, "weight": 1.0 },
    "vrm_band": { "low": 62.0, "span": 26.0, "weight": 1.0 },
    "weights": { "cpu_to_gpu": 0.45, "vrm_to_cpu": 0.85, "vrm_to_gpu": 0.55 },
    "emergency": { "cpu_c": 93.0, "gpu_c": 83.0, "pwm": 255 },
    "caps": {
      "enabled": false,
      "cpu_pwm_max": 190,
      "gpu_pwm_max": 255,
      "override_temp_c": 96,
      "verified": false,
      "rationale": "3912 -> 5773 RPM на CPU дал +48 % шума при -0.2 C. Кеп 190 (~4300 RPM) стоит МЕЖДУ двумя проверенными точками. enabled=false = поведение ровно как в проверенной фазе P3; включить после контрольной фазы."
    }
  },

  "brutal": {
    "cpu_on_c": 82,
    "gpu_on_c": 78,
    "cpu_off_c": 74,
    "gpu_off_c": 70,
    "base_pwm": 110,
    "hot_pwm": 255
  },

  "loadgen": {
    "yield": { "cpu_c": 96, "busy_pct": 85, "gpu_util_pct": 92 },
    "light": { "cpu_c": 90, "busy_pct": 70, "gpu_util_pct": 80, "cpu_threads": 3, "gpu_duty": 40 },
    "full":  { "cpu_threads": 8, "gpu_duty": 85 },
    "affinity": "taskset -c 2-15, nice -n 19, ionice -c3",
    "state_file": "loadgen.state"
  },

  "provenance": {
    "report": "vertil/docs/2026-09-30-3phase-fan-test-report.md",
    "report_snapshot": "vertil/config/report-2026-09-30.md",
    "hw_report": "vertil/docs/2026-09-30-fan-hw-access-report.md",
    "logs": [
      "vertil/docs/logs/phase1a_bios_auto_noinjected_load.csv",
      "vertil/docs/logs/phase1_bios_auto.csv",
      "vertil/docs/logs/phase2_brutal.csv",
      "vertil/docs/logs/phase3_smart.csv",
      "vertil/docs/logs/finalize_auto_restore.log"
    ],
    "analysis_tool": "vertil/tools/lab/analyze.py"
  },

  "baseline": {
    "note": "Ключевые цифры 3-фазного теста (2026-09-30) — точка отсчёта для будущих изменений пресета.",
    "phases": {
      "P1_bios_auto": { "dur_s": 300, "busy_pct": 39.8, "tcpu_mean": 95.6, "tcpu_p95": 99.0,
                        "tgpu_mean": 77.5, "tvrm_mean": 95.6, "fan1_rpm": 3912, "fan2_rpm": 4200,
                        "thr_per_min": 7478, "thr_per_min_per_busy": 18778 },
      "P2_brutal":     { "dur_s": 360, "busy_pct": 45.2, "tcpu_mean": 95.4, "tcpu_p95": 99.0,
                        "tgpu_mean": 68.8, "tvrm_mean": 95.2, "fan1_rpm": 5773, "fan2_rpm": 5828,
                        "thr_per_min": 7382, "thr_per_min_per_busy": 16314 },
      "P3_smart":      { "dur_s": 480, "busy_pct": 46.1, "tcpu_mean": 95.2, "tcpu_p95": 99.0,
                        "tgpu_mean": 70.4, "tvrm_mean": 95.4, "fan1_rpm": 5779, "fan2_rpm": 5762,
                        "thr_per_min": 7187, "thr_per_min_per_busy": 15589, "freq_mean_mhz": 3263 }
    },
    "key_findings": [
      "CPU: 3912 -> 5773 RPM = +48 % шума при -0.2 C (не лимитируется вентиляторами выше ~4000 RPM)",
      "GPU: 4200 -> 5800 RPM = -8.7 C (лимитируется)",
      "0 RPM ~215 с при 92-99 C -> 3900 RPM даёт -18 C за ~45 с",
      "SMART: -17 % троттлинга на единицу работы относительно BIOS AUTO",
      "Абсолютное время троттлинга одинаково у всех режимов (~38 %)"
    ]
  }
}
